<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-maccatalyst</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IELTop.Desktop</RootNamespace>
    <AssemblyName>IELTop.Desktop</AssemblyName>
    <ApplicationTitle>IELTop</ApplicationTitle>
    <ApplicationId>com.ieltops.desktop</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <Company>IELTop</Company>
    <Product>IELTop</Product>
    <Description>IELTop desktop client. .NET MAUI shell with web UI.</Description>
    <ApplicationIcon>..\Content\Assets\Images\app.ico</ApplicationIcon>

    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Build the web UI before the C# build, so dotnet build alone brings
       everything up to date. Skipped when npm is missing, so a machine without
       Node still builds the app from the committed output if present. -->
  <PropertyGroup>
    <UiDir>$(MSBuildProjectDirectory)\UserInterface</UiDir>
    <UiStamp>$(UiDir)\node_modules\.install-stamp</UiStamp>
  </PropertyGroup>

  <Target Name="WebUiInstall" Condition="!Exists('$(UiStamp)')">
    <Exec Command="npm install --no-fund --no-audit" WorkingDirectory="$(UiDir)" ContinueOnError="true" />
    <Touch Files="$(UiStamp)" AlwaysCreate="true" Condition="Exists('$(UiDir)\node_modules')" />
  </Target>

  <Target Name="WebUiBuild" DependsOnTargets="WebUiInstall" BeforeTargets="PrepareForBuild">
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" ContinueOnError="true" />
    <Warning Text="The web UI build was skipped. Run 'npm run build' in IELTop.Desktop/UserInterface if the app shows a blank page."
             Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IELTop.Core\IELTop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built web UI. npm build writes here, and it is copied next to
         the app so the local file server can read it. -->
    <None Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyWwwrootToOutput" AfterTargets="Build">
    <ItemGroup>
      <_WwwrootFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwrootFiles)"
          DestinationFolder="$(TargetDir)wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\Content\Assets\Exams\**" Link="Assets\Exams\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Content\Assets\Audio\**" Link="Assets\Audio\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Content\Assets\Images\**" Link="Assets\Images\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Content\Assets\Models\README.md" Link="Assets\Models\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Content\Assets\Models\phoneme-map.json" Link="Assets\Models\phoneme-map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Content\servers.txt" Link="servers.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
