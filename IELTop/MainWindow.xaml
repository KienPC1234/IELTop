<Window x:Class="IELTop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="IELTop, mock test only" Height="780" Width="1240"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="ExamQuestionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Content="{Binding FlagLabel}" FontSize="12"
                                  IsChecked="{Binding IsFlagged}"/>
                    </Grid>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14"/>
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Text}" Margin="0,3"
                                             GroupName="{Binding GroupName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <TextBlock Text="IELTop" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mock test only" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
                    <ListBoxItem Content="Overview" Tag="Overview"/>
                    <ListBoxItem Content="Mock Test" Tag="Exam"/>
                    <ListBoxItem Content="Results" Tag="Results"/>
                    <ListBoxItem Content="Settings" Tag="Settings"/>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="4,16,4,0">
                    <TextBlock Text="MODELS" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ModelsSummary}" FontSize="13" Foreground="White"/>
                    <TextBlock Text="LANGUAGE MODEL" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding LlmSummary}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920">

                <!-- ===================== Overview ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Overview}">
                    <TextBlock Text="Overview" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Mock tests with bands and AI feedback. No practice sections." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Finished tests" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding ExamCount}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Full or single skill runs." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Last band range" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding LastBand}" Style="{StaticResource StatValue}" FontSize="26"/>
                                <TextBlock Text="Range, because examiners vary. Practice estimate only." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="How it works" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="1. Open Mock Test, pick Full test or one skill. 2. Choose Lenient, Standard, or Strict marking. 3. Turn on Strict mode for full screen. 4. Submit, then press Grade with AI for band ranges and detailed feedback."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ModelsSummary, StringFormat=Offline models ready: {0}}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding LlmSummary, StringFormat=Language model: {0}}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                            <TextBlock Text="Missing model files are fine. Objective parts score offline. AI bands need a model in Settings."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource GhostButton}" Content="Refresh" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Command="{Binding RefreshStatsCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Offline models" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ModelsFolder}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Models}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding State}" FontSize="11" Margin="8,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding Message, Converter={StaticResource String2Visibility}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Load"
                                                    VerticalAlignment="Top" Command="{Binding LoadCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Mock Test ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Exam}">
                    <TextBlock Text="Mock Test" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Computer delivered style. Timed parts, one screen, band ranges." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <Border Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Test setup" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Paper" Foreground="#9CA3AF" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Exam.Papers}" SelectedItem="{Binding Exam.SelectedPaper}"
                                              DisplayMemberPath="Title" Padding="8" Margin="0,2,0,8"
                                              hc:InfoElement.Placeholder="Choose a test paper"/>
                                    <TextBlock Text="Scope" Foreground="#9CA3AF" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Exam.Scopes}" SelectedItem="{Binding Exam.SelectedScope}"
                                              Padding="8" Margin="0,2,0,0"/>
                                    <TextBlock Text="Listening only runs inside a full test, because its audio cannot be split."
                                               Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Marking level" Foreground="#9CA3AF" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Exam.StrictnessOptions}" SelectedItem="{Binding Exam.SelectedStrictness}"
                                              Padding="8" Margin="0,2,0,8"/>
                                    <CheckBox Content="Strict mode (full screen, stay in test)" Foreground="White" Margin="0,2,0,0"
                                              IsChecked="{Binding Exam.StrictMode}"/>
                                    <CheckBox Content="Shuffle parts" Foreground="White" Margin="0,6,0,0"
                                              IsChecked="{Binding Exam.ShuffleParts}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Exam.StrictModeHint}" Foreground="#9CA3AF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start test" Margin="0,0,8,8"
                                        Command="{Binding Exam.StartExamCommand}"
                                        IsEnabled="{Binding Exam.IsRunning, Converter={StaticResource InverseBool}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Submit" Margin="0,0,8,8"
                                        Command="{Binding Exam.SubmitExamCommand}"
                                        IsEnabled="{Binding Exam.IsRunning}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Topic idea with AI" Margin="0,0,8,8"
                                        Command="{Binding Exam.SuggestTopicCommand}"
                                        IsEnabled="{Binding Exam.CanUseAi}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Exam.StatusMessage}" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Add a language model in Settings for AI bands and topics."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding Exam.ShowAiHint, Converter={StaticResource Bool2Visibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Exam.ShowNoPaperWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Exam.MaterialWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding Exam.IsRunning, Converter={StaticResource Bool2Visibility}}">
                        <!-- IDP style top bar: part title, timer in the middle, volume on the right -->
                        <Border Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Exam.CurrentPart.Title}" Foreground="White"
                                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Time left  " Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Exam.CurrentPart.RemainingLabel}" Foreground="White"
                                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}">
                                    <TextBlock Text="Volume  " Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Exam.Volume}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Part tabs, like the bottom navigation of the real test -->
                        <ItemsControl ItemsSource="{Binding Exam.Parts}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding TabLabel}" Margin="0,0,6,6"
                                            Padding="12,6" Command="{Binding DataContext.Exam.GoToPartCommand,
                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Exam.CurrentPart.HeaderLine}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Exam.CurrentPart.Instructions}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="Speaking runs without pause. Record once, then finish the part."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Exam.CurrentPart.IsSpeaking, Converter={StaticResource Bool2Visibility}}"/>
                                        <TextBlock Text="The clip plays once and does not replay, like the real test."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Reading split screen: passage on the left, questions on the right -->
                                <Grid Margin="0,0,0,10"
                                      Visibility="{Binding Exam.CurrentPart.IsReading, Converter={StaticResource Bool2Visibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding Exam.CurrentPart.Material}" TextWrapping="Wrap" FontSize="13"/>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <ItemsControl ItemsSource="{Binding Exam.CurrentPart.Questions}"
                                                      ItemTemplate="{StaticResource ExamQuestionTemplate}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Listening transcript stays visible while the clip plays -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Audio" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding Exam.CurrentPart.AudioStatus}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                                Visibility="{Binding Exam.CurrentPart.HasMaterial, Converter={StaticResource Bool2Visibility}}">
                                            <TextBlock Text="{Binding Exam.CurrentPart.Material}" TextWrapping="Wrap" FontSize="13"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsWriting, Converter={StaticResource Bool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Your answer" Style="{StaticResource SectionTitle}"/>
                                        <TextBox Text="{Binding Exam.CurrentPart.Essay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="250" TextWrapping="Wrap" Padding="10"
                                                 VerticalScrollBarVisibility="Auto" FontSize="14"
                                                 hc:InfoElement.Placeholder="Write your answer here."/>
                                        <TextBlock Text="{Binding Exam.CurrentPart.WordCountLabel}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        <TextBlock Text="Writing is marked by AI after submit. Bands are ranges for practice."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsSpeaking, Converter={StaticResource Bool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Your speech" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Record answer" Margin="0,0,8,8"
                                                    Command="{Binding Exam.RecordSpeakingCommand}"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Finish part" Margin="0,0,8,8"
                                                    Command="{Binding Exam.FinishSpeakingPartCommand}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Exam.CurrentPart.AudioStatus}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="Type what you said" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                        <TextBox Text="{Binding Exam.CurrentPart.Transcript, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" Padding="10"
                                                 VerticalScrollBarVisibility="Auto" FontSize="14"
                                                 hc:InfoElement.Placeholder="Type your spoken answer here for AI marking."/>
                                        <TextBlock Text="{Binding Exam.CurrentPart.TranscriptWordCount}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Exam.CurrentPart.IsReading, Converter={StaticResource InverseBool}}">
                                    <ItemsControl ItemsSource="{Binding Exam.CurrentPart.Questions}"
                                                  ItemTemplate="{StaticResource ExamQuestionTemplate}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Parts" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Previous part" Margin="0,0,0,6"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding Exam.PreviousPartCommand}"
                                                IsEnabled="{Binding Exam.CanGoBack}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Next part"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding Exam.NextPartCommand}"
                                                IsEnabled="{Binding Exam.CanGoNext}"/>
                                        <TextBlock Text="No pause in Speaking. Listening plays once."
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding Exam.ShowResult, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Exam.BandLabel, StringFormat=Band range: {0}}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding Exam.HasBand, Converter={StaticResource Bool2Visibility}}"/>
                            <TextBlock Text="{Binding Exam.ResultText}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Exam.CriteriaHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Grade with AI" Margin="0,0,8,8"
                                        Command="{Binding Exam.GradeWithAiCommand}"
                                        IsEnabled="{Binding Exam.CanUseAi}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Show answer review" Margin="0,0,8,8"
                                        Command="{Binding Exam.ToggleReviewCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="Add a language model in Settings for detailed AI bands."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Exam.ShowAiHint, Converter={StaticResource Bool2Visibility}}"/>
                            <ItemsControl ItemsSource="{Binding Exam.AiFeedbackLines}" Margin="0,10,0,0"
                                          Visibility="{Binding Exam.HasAiFeedback, Converter={StaticResource Bool2Visibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Exam.ReviewLines}" Margin="0,10,0,0"
                                          Visibility="{Binding Exam.ShowReview, Converter={StaticResource Bool2Visibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Results ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Results}">
                    <TextBlock Text="Results" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Results.SummaryLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource GhostButton}" Content="Reload" Margin="0,0,8,8" Command="{Binding Results.LoadCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Clear all" Margin="0,0,8,8" Command="{Binding Results.ClearAllCommand}"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Results.Attempts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PaperTitle}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding Scope}"/><Run Text=" | "/><Run Text="{Binding Strictness}"/><Run Text=" | "/><Run Text="{Binding CreatedAt}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0">
                                            <Run Text="{Binding BandLow, StringFormat={}{0:0.0}}"/><Run Text=" to "/><Run Text="{Binding BandHigh, StringFormat={}{0:0.0}}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Official criteria" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Results.CriteriaHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Writing bands" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding Results.WritingTable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Speaking bands" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Results.SpeakingTable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="All bands are practice estimates, not official IELTS scores." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Settings ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Settings}">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Language model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Optional. Works with any server that speaks the OpenAI chat completions API, such as OpenAI, Ollama, LM Studio, llama.cpp server or vLLM. It powers AI bands and feedback for Writing and Speaking."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Base URL" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="https://api.openai.com/v1"
                                     Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Model name" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="gpt-4o-mini or llama3.1"
                                     Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="API key (leave empty for a local server)" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,6" Padding="8" hc:InfoElement.Placeholder="sk-..."
                                     Text="{Binding Settings.ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="The key is stored encrypted on this computer with Windows data protection."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Temperature" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="0" Maximum="2" Increment="0.1" DecimalPlaces="1"
                                                      Value="{Binding Settings.Temperature}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Max reply length" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="64" Maximum="8192" Increment="64" DecimalPlaces="0"
                                                      Value="{Binding Settings.MaxTokens}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Stream replies as they are written" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.UseStreaming}"/>
                            <CheckBox Content="This model can read images (vision)" Margin="0,6,0,0"
                                      IsChecked="{Binding Settings.VisionEnabled}"/>
                            <TextBlock Text="Turn on vision only if the model supports it, for example gpt-4o or llava."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Check" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Settings.CheckSummary}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Settings.Problems}" Margin="0,8,0,0"
                                                  Visibility="{Binding Settings.HasProblems, Converter={StaticResource Bool2Visibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,8,8"
                                        Command="{Binding Settings.SaveCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Test connection" Margin="0,0,8,8"
                                        Command="{Binding Settings.TestConnectionCommand}"
                                        IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <hc:LoadingCircle IsRunning="{Binding Settings.IsBusy}"
                                                  Visibility="{Binding Settings.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding Settings.StatusMessage}" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                    Visibility="{Binding Settings.HasDebugDetails, Converter={StaticResource Bool2Visibility}}">
                                <StackPanel>
                                    <TextBlock Text="Connection details" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Settings.DebugDetails}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="What works without a model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Mock Test always works offline. AI bands, topic ideas, and detailed feedback stay disabled until a model is set here."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE">
                        <StackPanel>
                            <TextBlock Text="Example local setups" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Ollama: base URL http://localhost:11434/v1, model llama3.1, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="LM Studio: base URL http://localhost:1234/v1, model from the loaded server, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="OpenAI: base URL https://api.openai.com/v1, model gpt-4o-mini, key required."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
