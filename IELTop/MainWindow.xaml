<Window x:Class="IELTop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="IELTop, offline IELTS practice" Height="780" Width="1240"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Shared question block for Reading and Listening -->
        <DataTemplate x:Key="PracticeQuestionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding NumberLabel}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14"/>
                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Text}" Margin="0,3"
                                             GroupName="{Binding GroupName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ResultLabel}" FontSize="12" Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding ResultLabel, Converter={StaticResource String2Visibility}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Exam question block -->
        <DataTemplate x:Key="ExamQuestionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding NumberLabel}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14"/>
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Text}" Margin="0,3"
                                             GroupName="{Binding GroupName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Dashboard tile -->
        <DataTemplate x:Key="StatTile">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <TextBlock Text="IELTop" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Offline IELTS practice" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
                    <ListBoxItem Content="Overview" Tag="Overview"/>
                    <ListBoxItem Content="Vocabulary" Tag="Vocabulary"/>
                    <ListBoxItem Content="Reading" Tag="Reading"/>
                    <ListBoxItem Content="Listening" Tag="Listening"/>
                    <ListBoxItem Content="Writing" Tag="Writing"/>
                    <ListBoxItem Content="Speaking" Tag="Speaking"/>
                    <ListBoxItem Content="Mock Test" Tag="Exam"/>
                    <ListBoxItem Content="Models" Tag="Models"/>
                    <ListBoxItem Content="Content" Tag="Content"/>
                    <ListBoxItem Content="Settings" Tag="Settings"/>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="4,16,4,0">
                    <TextBlock Text="MODELS" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ModelsSummary}" FontSize="13" Foreground="White"/>
                    <TextBlock Text="LANGUAGE MODEL" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding LlmSummary}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" Padding="28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920">

                <!-- ===================== Overview ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Overview}">
                    <TextBlock Text="Overview" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Your local practice, at a glance." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Words saved" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding WordCount}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Add more in Vocabulary." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Speaking tries" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding AttemptCount}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Recorded practice attempts." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Average accuracy" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding AverageAccuracy}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Across saved attempts." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Setup" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ModelsSummary, StringFormat=Offline models ready: {0}}"/>
                                    <TextBlock Text="{Binding LlmSummary, StringFormat=Language model: {0}}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                                    <TextBlock Text="Missing models are fine. The app still works offline."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Refresh"
                                        VerticalAlignment="Top" Command="{Binding RefreshStatsCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Vocabulary" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Save words, review them, and ask the model for explanations."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Open Vocabulary"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding Vocabulary.LoadCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Reading and Listening" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Answer questions with instant local checking, no model needed."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Writing" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Draft an essay and get structured feedback with an estimated band."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Mock Test" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Timed parts, one screen, submit and review answers like the real test."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- ===================== Vocabulary ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Vocabulary}">
                    <TextBlock Text="Vocabulary" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Add a word" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,8" Padding="8"
                                         hc:InfoElement.Placeholder="Word"
                                         Text="{Binding Vocabulary.NewWord, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Margin="0,0,0,8" Padding="8"
                                         hc:InfoElement.Placeholder="Meaning"
                                         Text="{Binding Vocabulary.NewMeaning, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBox Margin="0,0,0,8" Padding="8"
                                     hc:InfoElement.Placeholder="Example sentence (optional)"
                                     Text="{Binding Vocabulary.NewExample, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8"
                                         hc:InfoElement.Placeholder="Topic (optional)"
                                         Text="{Binding Vocabulary.NewTopic, UpdateSourceTrigger=PropertyChanged}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="1" Maximum="5" DecimalPlaces="0" Increment="1"
                                                  Value="{Binding Vocabulary.NewLevel}"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add word" Margin="0,0,8,8"
                                        Command="{Binding Vocabulary.AddWordCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Explain with AI" Margin="0,0,8,8"
                                        Command="{Binding Vocabulary.ExplainWithAiCommand}"
                                        IsEnabled="{Binding Vocabulary.CanUseAi}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Reload" Margin="0,0,8,8"
                                        Command="{Binding Vocabulary.LoadCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Vocabulary.StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Vocabulary.HasAiExplanation, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="AI explanation" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Vocabulary.AiExplanation}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Vocabulary.Words}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Word}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="8,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Example}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                       Visibility="{Binding HasExample, Converter={StaticResource Bool2Visibility}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostButton}" Content="Reveal" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.Vocabulary.ToggleRevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Delete"
                                                    Command="{Binding DataContext.Vocabulary.DeleteWordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===================== Reading ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Reading}">
                    <TextBlock Text="Reading" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Reading.ShowNoPassageWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Reading.NoPassageWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Reading.Passages}" SelectedItem="{Binding Reading.SelectedPassage}"
                                      DisplayMemberPath="Title" Padding="8"
                                      hc:InfoElement.Placeholder="Choose a passage"/>
                            <TextBlock Text="{Binding Reading.SourceLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Reading.HasBody, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Reading.Body}" TextWrapping="Wrap" FontSize="14" LineHeight="23"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Reading.Questions}"
                                  ItemTemplate="{StaticResource PracticeQuestionTemplate}"/>

                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding Reading.HasQuestions, Converter={StaticResource Bool2Visibility}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="Check answers" Margin="0,0,8,0"
                                Command="{Binding Reading.CheckAnswersCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Clear answers"
                                Command="{Binding Reading.ResetAnswersCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Reading.StatusMessage}" FontSize="13" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ===================== Listening ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Listening}">
                    <TextBlock Text="Listening" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Listening.ShowNoItemWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Listening.NoItemWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Listening.Items}" SelectedItem="{Binding Listening.SelectedItem}"
                                      DisplayMemberPath="Title" Padding="8"
                                      hc:InfoElement.Placeholder="Choose a listening item"/>
                            <TextBlock Text="{Binding Listening.SourceLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Listening.AudioStatus}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Play" Margin="0,0,8,0"
                                        Command="{Binding Listening.PlayCommand}"
                                        IsEnabled="{Binding Listening.AudioExists}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Show transcript"
                                        Command="{Binding Listening.ToggleTranscriptCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Listening.ShowTranscript, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Transcript" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Listening.Transcript}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Listening.Questions}"
                                  ItemTemplate="{StaticResource PracticeQuestionTemplate}"/>

                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding Listening.HasQuestions, Converter={StaticResource Bool2Visibility}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="Check answers" Margin="0,0,8,0"
                                Command="{Binding Listening.CheckAnswersCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Clear answers"
                                Command="{Binding Listening.ResetAnswersCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Listening.StatusMessage}" FontSize="13" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ===================== Writing ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Writing}">
                    <TextBlock Text="Writing" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Writing.ShowNoTaskWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Writing.NoTaskWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Writing.Tasks}" SelectedItem="{Binding Writing.SelectedTask}"
                                      DisplayMemberPath="Title" Padding="8"
                                      hc:InfoElement.Placeholder="Choose a writing task"/>
                            <TextBlock Text="{Binding Writing.SelectedTask.Prompt}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding Writing.StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBox Text="{Binding Writing.Essay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="240" TextWrapping="Wrap" Padding="10"
                                     VerticalScrollBarVisibility="Auto" FontSize="14"
                                     hc:InfoElement.Placeholder="Write your answer here."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Writing.WordCountLabel}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Recommended minimum: " FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding Writing.MinimumWords}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Get AI feedback" Margin="0,0,10,8"
                                        Command="{Binding Writing.ReviewCommand}"
                                        IsEnabled="{Binding Writing.CanUseAi}"/>
                                <hc:LoadingCircle IsRunning="{Binding Writing.IsBusy}"
                                                  Visibility="{Binding Writing.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="Add a language model in Settings to get feedback."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Writing.ShowAiHint, Converter={StaticResource Bool2Visibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Writing.HasFeedback, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Feedback" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="5" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Estimated band" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Writing.EstimatedBand, StringFormat={}{0:0.0}}"
                                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Task" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Writing.TaskResponse, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Coherence" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Writing.Coherence, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Vocabulary" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Writing.LexicalResource, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Grammar" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Writing.Grammar, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="These bands are estimates for practice. They are not official IELTS scores."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Writing.FeedbackSummary}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"/>

                            <TextBlock Text="Strengths" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Writing.Strengths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Improvements" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Writing.Improvements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding Writing.HasCorrectedExcerpt, Converter={StaticResource Bool2Visibility}}">
                                <TextBlock Text="Example rewrite" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding Writing.CorrectedExcerpt}" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Speaking ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Speaking}">
                    <TextBlock Text="Speaking" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sample sentence to read" Style="{StaticResource SectionTitle}"/>
                            <TextBox hc:InfoElement.Placeholder="Example: I think this is a very good idea."
                                     Text="{Binding Speaking.TargetText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="10" MinHeight="38"/>
                            <TextBlock Text="Read the sentence clearly within 5 seconds after you press Record."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Record and score" Margin="0,0,8,8"
                                        Command="{Binding Speaking.RecordAndAssessCommand}"
                                        IsEnabled="{Binding Speaking.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Show target sounds" Margin="0,0,8,8"
                                        Command="{Binding Speaking.ShowExpectedCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Speaking tips with AI" Margin="0,0,8,8"
                                        Command="{Binding Speaking.CoachWithAiCommand}"
                                        IsEnabled="{Binding Speaking.CanUseAi}"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <hc:LoadingCircle IsRunning="{Binding Speaking.IsBusy}"
                                                  Visibility="{Binding Speaking.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Speaking.StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Speaking.ShowModelWarning, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Pronunciation model is not installed" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Open tools/speaking-mdd, export the model, then copy it into Assets/Models. Until then the Record button reports a missing file instead of failing silently."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Speaking.ResultSummary}" FontWeight="SemiBold" FontSize="15"/>
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Accuracy" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                        <Run Text="{Binding Speaking.Accuracy, StringFormat={}{0:0.#}}"/><Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Wrong sound" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Speaking.Substitutions}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Dropped" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Speaking.Omissions}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Added" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Speaking.Insertions}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Speaking.HasAiCoaching, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="AI coaching" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Speaking.AiCoaching}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Specific mistakes" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Speaking.Mistakes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="13"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sounds" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Target" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Speaking.ExpectedPhonemes}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Margin="0,2,0,8"/>
                            <TextBlock Text="Heard by the model" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Speaking.HeardPhonemes}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Mock Test ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Exam}">
                    <TextBlock Text="Mock Test" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Computer delivered style" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Timed parts, one question per block, submit at the end."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ComboBox Width="340" ItemsSource="{Binding Exam.Papers}"
                                          SelectedItem="{Binding Exam.SelectedPaper}"
                                          DisplayMemberPath="Title" Padding="8"
                                          hc:InfoElement.Placeholder="Choose a test paper"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Start test" Margin="10,0,0,0"
                                        Command="{Binding Exam.StartExamCommand}"
                                        IsEnabled="{Binding Exam.IsRunning, Converter={StaticResource InverseBool}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Submit" Margin="10,0,0,0"
                                        Command="{Binding Exam.SubmitExamCommand}"
                                        IsEnabled="{Binding Exam.IsRunning}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Exam.ShowNoPaperWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Exam.MaterialWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Visibility="{Binding Exam.IsRunning, Converter={StaticResource Bool2Visibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Exam.CurrentPart.Title}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{Binding Exam.CurrentPart.Instructions}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                            Visibility="{Binding Exam.CurrentPart.HasMaterial, Converter={StaticResource Bool2Visibility}}">
                                        <TextBlock Text="{Binding Exam.CurrentPart.Material}" TextWrapping="Wrap" FontSize="13"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                    Visibility="{Binding Exam.CurrentPart.IsWriting, Converter={StaticResource Bool2Visibility}}">
                                <StackPanel>
                                    <TextBlock Text="Your answer" Style="{StaticResource SectionTitle}"/>
                                    <TextBox Text="{Binding Exam.CurrentPart.Essay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="250" TextWrapping="Wrap" Padding="10"
                                             VerticalScrollBarVisibility="Auto" FontSize="14"
                                             hc:InfoElement.Placeholder="Write your answer here."/>
                                    <TextBlock Text="{Binding Exam.CurrentPart.WordCountLabel}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="Writing answers are saved with the paper but not auto scored."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Exam.CurrentPart.Questions}"
                                          ItemTemplate="{StaticResource ExamQuestionTemplate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE">
                                <StackPanel>
                                    <TextBlock Text="Time left" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Exam.CurrentPart.RemainingLabel}" FontSize="30" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Parts" Style="{StaticResource SectionTitle}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Previous part" Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding Exam.PreviousPartCommand}"
                                            IsEnabled="{Binding Exam.CanGoBack}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Next part"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding Exam.NextPartCommand}"
                                            IsEnabled="{Binding Exam.CanGoNext}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding Exam.ShowResult, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Exam.ResultText}" TextWrapping="Wrap" FontSize="13"/>
                            <TextBlock Text="The band value is a rough guide for multiple choice practice. It is not an official IELTS score."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Show answer review" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Command="{Binding Exam.ToggleReviewCommand}"/>
                            <ItemsControl ItemsSource="{Binding Exam.ReviewLines}" Margin="0,10,0,0"
                                          Visibility="{Binding Exam.ShowReview, Converter={StaticResource Bool2Visibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Models ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Models}">
                    <TextBlock Text="Models" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ModelsSummary, StringFormat=Ready: {0}}"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Folder" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ModelsFolder}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource GhostButton}" Content="Refresh" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Command="{Binding RefreshStatsCommand}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding State}" FontSize="11" Margin="8,2,0,0"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{Binding Origin, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding License, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Message}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding Message, Converter={StaticResource String2Visibility}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Load"
                                                VerticalAlignment="Top" Command="{Binding LoadCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===================== Content ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Content}">
                    <TextBlock Text="Content" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Import study files, or export what you already have to share."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Import -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Import" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Reads text out of txt, md, json, csv, pdf and docx files. Photos of pages can be read too, when vision is set up in Settings."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Import files" Margin="0,0,8,8"
                                            Command="{Binding Content.ImportFilesCommand}"
                                            IsEnabled="{Binding Content.IsBusy, Converter={StaticResource InverseBool}}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Preview one file" Margin="0,0,8,8"
                                            Command="{Binding Content.PreviewFileCommand}"
                                            IsEnabled="{Binding Content.IsBusy, Converter={StaticResource InverseBool}}"/>
                                </WrapPanel>

                                <TextBlock Text="With a language model, import also drafts questions. Without one, it saves the text and you fill in the rest."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="Images need a model with vision turned on in Settings. Without it, image import reports what to change."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Content.ShowVisionHint, Converter={StaticResource Bool2Visibility}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <hc:LoadingCircle IsRunning="{Binding Content.IsBusy}"
                                                      Visibility="{Binding Content.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                      Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Content.StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Content.ImportedFiles}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Export -->
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Export" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Writes files into a new folder so you can share a paper or a whole set."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Mock paper" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <ComboBox ItemsSource="{Binding Content.Papers}" SelectedItem="{Binding Content.SelectedPaper}"
                                          DisplayMemberPath="Title" Padding="8" Margin="0,2,0,10"
                                          hc:InfoElement.Placeholder="Choose a paper"/>

                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Export selected paper" Margin="0,0,8,8"
                                            Command="{Binding Content.ExportSelectedPaperCommand}"
                                            IsEnabled="{Binding Content.HasPapers}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Export all papers" Margin="0,0,8,8"
                                            Command="{Binding Content.ExportAllPapersCommand}"
                                            IsEnabled="{Binding Content.HasPapers}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Export all practice" Margin="0,0,8,8"
                                            Command="{Binding Content.ExportAllPracticeCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding Content.HasDraft, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Title" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8"
                                     Text="{Binding Content.ImportTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Type" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding Content.Kinds}" SelectedItem="{Binding Content.DraftKind}"
                                      Margin="0,2,0,10" Padding="8"/>

                            <TextBlock Text="{Binding Content.DraftLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBox Text="{Binding Content.ImportPreview}" IsReadOnly="True" AcceptsReturn="True"
                                     MinHeight="180" TextWrapping="Wrap" Padding="10" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" Background="#F9FAFB"/>

                            <Button Style="{StaticResource PrimaryButton}" Content="Save this draft" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Command="{Binding Content.SavePreviewCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Settings ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Settings}">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Language model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Optional. Works with any server that speaks the OpenAI chat completions API, such as OpenAI, Ollama, LM Studio, llama.cpp server or vLLM. It powers AI feedback for Writing, Speaking and Vocabulary."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Base URL" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="https://api.openai.com/v1"
                                     Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Model name" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="gpt-4o-mini or llama3.1"
                                     Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="API key (leave empty for a local server)" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,6" Padding="8" hc:InfoElement.Placeholder="sk-..."
                                     Text="{Binding Settings.ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="The key is stored encrypted on this computer with Windows data protection."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Temperature" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="0" Maximum="2" Increment="0.1" DecimalPlaces="1"
                                                      Value="{Binding Settings.Temperature}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Max reply length" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="64" Maximum="8192" Increment="64" DecimalPlaces="0"
                                                      Value="{Binding Settings.MaxTokens}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Stream replies as they are written" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.UseStreaming}"/>
                            <CheckBox Content="This model can read images (vision)" Margin="0,6,0,0"
                                      IsChecked="{Binding Settings.VisionEnabled}"/>
                            <TextBlock Text="Turn on vision only if the model supports it, for example gpt-4o or llava. Otherwise image import would fail."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Check" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Settings.CheckSummary}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Settings.Problems}" Margin="0,8,0,0"
                                                  Visibility="{Binding Settings.HasProblems, Converter={StaticResource Bool2Visibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,8,8"
                                        Command="{Binding Settings.SaveCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Test connection" Margin="0,0,8,8"
                                        Command="{Binding Settings.TestConnectionCommand}"
                                        IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <hc:LoadingCircle IsRunning="{Binding Settings.IsBusy}"
                                                  Visibility="{Binding Settings.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding Settings.StatusMessage}" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="What works without a model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Reading, Listening, Vocabulary, and Mock Test always work offline. Writing feedback, word explanations, speaking tips, and the AI part of import stay disabled until a model is set here."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE">
                        <StackPanel>
                            <TextBlock Text="Example local setups" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Ollama: base URL http://localhost:11434/v1, model llama3.1, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="LM Studio: base URL http://localhost:1234/v1, model from the loaded server, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="OpenAI: base URL https://api.openai.com/v1, model gpt-4o-mini, key required."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
