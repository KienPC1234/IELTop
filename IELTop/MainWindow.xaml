<Window x:Class="IELTop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:IELTop.Styles"
        Title="IELTop, mock test only" Height="780" Width="1240"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <TextBlock Text="IELTop" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mock test only" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
                    <ListBoxItem Tag="Overview">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Rectangle Width="6" Height="6" Canvas.Left="1" Canvas.Top="1"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Rectangle Width="6" Height="6" Canvas.Left="9" Canvas.Top="1"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Rectangle Width="6" Height="6" Canvas.Left="1" Canvas.Top="9"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Rectangle Width="6" Height="6" Canvas.Left="9" Canvas.Top="9"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Overview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Exam">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Ellipse Width="13" Height="13" Canvas.Left="1.5" Canvas.Top="1.5" StrokeThickness="2"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="8" Y1="8" X2="8" Y2="4.5" StrokeThickness="2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="8" Y1="8" X2="11" Y2="9.5" StrokeThickness="2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Mock Test" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource BadgeGray}" Margin="8,0,0,0" Background="#1F2937"
                                    Visibility="{Binding PapersCount, Converter={StaticResource Count2Visibility}}">
                                <TextBlock Text="{Binding PapersCount}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Library">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Rectangle Width="3.5" Height="12" Canvas.Left="1.5" Canvas.Top="2"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Rectangle Width="3.5" Height="9" Canvas.Left="6.5" Canvas.Top="5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Rectangle Width="3.5" Height="12" Canvas.Left="11" Canvas.Top="2"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Editor">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Polygon Points="11,2 14,5 6,13 2,14 3,10"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Editor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Results">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Ellipse Width="8" Height="8" Canvas.Left="4" Canvas.Top="1"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Polygon Points="5,9 11,9 9,15 7,15"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Results" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource BadgeGray}" Margin="8,0,0,0" Background="#1F2937"
                                    Visibility="{Binding ExamCount, Converter={StaticResource Count2Visibility}}">
                                <TextBlock Text="{Binding ExamCount}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Servers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Rectangle Width="12" Height="13" Canvas.Left="2" Canvas.Top="1.5" StrokeThickness="1.5"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="4.5" Y1="5.5" X2="11.5" Y2="5.5" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="4.5" Y1="9.5" X2="11.5" Y2="9.5" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Servers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Line X1="1" Y1="3" X2="15" Y2="3" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="1" Y1="8" X2="15" Y2="8" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Line X1="1" Y1="13" X2="15" Y2="13" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="1"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="6"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Ellipse Width="4" Height="4" Canvas.Left="5" Canvas.Top="11"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Canvas>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="4,16,4,0">
                    <TextBlock Text="MODELS" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ModelsSummary}" FontSize="14" Foreground="White"/>
                    <TextBlock Text="LANGUAGE MODEL" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding LlmSummary}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Padding="28,16" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920">

                <!-- ===================== Overview ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Overview}">
                    <TextBlock Text="Overview" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Mock tests with bands and AI feedback. No practice sections." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Finished tests" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding ExamCount}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Full or single skill runs." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Last band range" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding LastBand}" Style="{StaticResource StatValue}" FontSize="26"/>
                                <TextBlock Text="Range, because examiners vary. Practice estimate only." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="How it works" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="1. Open Mock Test, pick Full test or one skill. 2. Choose Lenient, Standard, or Strict marking. 3. Turn on Strict mode for full screen. 4. Submit, then press Grade with AI for band ranges and detailed feedback."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Missing model files are fine. Objective parts score offline. AI bands need a model in Settings."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start a test" Margin="0,0,8,8"
                                        Command="{Binding GoExamCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Browse servers" Margin="0,0,8,8"
                                        Command="{Binding GoServersCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Refresh" Margin="0,0,8,8"
                                        Command="{Binding RefreshStatsCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Mock Test ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Exam}">
                    <TextBlock Text="Mock Test" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Computer delivered style. Timed parts, one screen, band ranges." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Step 1: Choose what to take" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Tick a skill. One skill runs alone, or tick several for a mixed test. Listening needs another skill too."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Paper" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding Exam.Papers}" SelectedItem="{Binding Exam.SelectedPaper}"
                                      DisplayMemberPath="Title" Padding="8" Margin="0,2,0,4"
                                      hc:InfoElement.Placeholder="Choose a test paper"/>
                            <TextBlock FontSize="11" Margin="0,0,0,12">
                                <Run Text="{Binding Exam.PaperCountLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                <Run Text=" "/>
                                <Hyperlink Command="{Binding GoLibraryCommand}">Manage in Library</Hyperlink>
                            </TextBlock>

                            <TextBlock Text="Skills" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Exam.SkillOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,8,8" MinWidth="180">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding HasParts}"
                                                          Content="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CountLabel}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="24,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0"
                                  Visibility="{Binding Exam.TaskTypeOptions.Count, Converter={StaticResource Count2Visibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Task types (advanced, leave all ticked for no filter)"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Exam.SelectedTaskTypesLabel}"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Exam.TaskTypeOptions}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                                  FontSize="13" Margin="0,0,16,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox Content="Mix parts from all papers" Margin="0,6,0,0"
                                      IsChecked="{Binding Exam.MixAllPapers}"/>
                            <TextBlock Text="{Binding Exam.SelectedSkillsLabel}"
                                       FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Step 2: Marking and rules" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Marking level" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding Exam.StrictnessOptions}" SelectedItem="{Binding Exam.SelectedStrictness}"
                                              Padding="8" Margin="0,2,0,0"/>
                                    <TextBlock Text="Lenient encourages, Standard is typical, Strict penalizes every error."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <CheckBox Content="Strict mode (full screen, stay in test)" Margin="0,2,0,0"
                                              IsChecked="{Binding Exam.StrictMode}"/>
                                    <TextBlock Text="{Binding Exam.StrictModeHint}"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Step 3: Build and start" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Test assembly" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding Exam.BuildModes}" SelectedItem="{Binding Exam.SelectedBuildMode}"
                                              Padding="8" Margin="0,2,0,0"/>
                                    <CheckBox Content="Shuffle parts" Margin="0,6,0,0"
                                              IsChecked="{Binding Exam.ShuffleParts}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Start test" Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch" Padding="14,12" FontSize="15"
                                            Command="{Binding Exam.StartExamCommand}"
                                            IsEnabled="{Binding Exam.CanStartSetup}"/>
                                    <TextBlock Text="The test opens in its own window with a timer, part tabs, and a question palette."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Topic idea with AI" Margin="0,0,8,8"
                                        Command="{Binding Exam.SuggestTopicCommand}"
                                        IsEnabled="{Binding Exam.CanUseAi}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Exam.StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Add a language model in Settings for AI bands and topics."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Exam.ShowAiHint, Converter={StaticResource Bool2Visibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Your papers" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Built in papers cannot be deleted. Your own papers can be edited or deleted. Use the Editor for full control."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Exam.PaperRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource BadgeGreen}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsUserPaper, Converter={StaticResource Bool2Visibility}}">
                                                        <TextBlock Text="Yours" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButton}" Content="Use"
                                                        Margin="8,0,6,0" Padding="10,4" ToolTip="Use this paper in the setup above"
                                                        Command="{Binding DataContext.Exam.UsePaperCommand,
                                                            RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Edit"
                                                        Margin="0,0,6,0" Padding="10,4"
                                                        Command="{Binding DataContext.Library.EditPaperCommand,
                                                            RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding Title}"/>
                                                <Button Style="{StaticResource DangerButton}" Content="Delete"
                                                        Margin="0,0,0,0" Padding="10,4"
                                                        Visibility="{Binding IsUserPaper, Converter={StaticResource Bool2Visibility}}"
                                                        Command="{Binding DataContext.Exam.DeletePaperCommand,
                                                            RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#FEF3C7" Margin="0,0,0,12" BorderBrush="#FDE68A"
                            Visibility="{Binding Exam.ShowNoPaperWarning, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="{Binding Exam.MaterialWarning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>

                <!-- ===================== Library ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Library}">
                    <TextBlock Text="Library" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Group, filter and manage papers. Drag papers into the basket to build one custom test."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

                    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBox Padding="8" Margin="0,0,8,8" MinWidth="200"
                                 hc:InfoElement.Placeholder="Search title or tag"
                                 Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox ItemsSource="{Binding Library.Categories}" SelectedItem="{Binding Library.SelectedCategory}"
                                  Padding="8" Margin="0,0,8,8" MinWidth="150"/>
                        <ComboBox ItemsSource="{Binding Library.Skills}" SelectedItem="{Binding Library.SelectedSkill}"
                                  Padding="8" Margin="0,0,8,8" MinWidth="130"/>
                        <Button Style="{StaticResource GhostButton}" Content="Reload" Margin="0,0,8,8"
                                Command="{Binding Library.LoadCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Clear filters" Margin="0,0,8,8"
                                Command="{Binding Library.ClearFiltersCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Browse servers" Margin="0,0,8,8"
                                Command="{Binding Library.GoServersCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Import files" Margin="0,0,8,8"
                                Command="{Binding Library.ImportPapersCommand}"
                                ToolTip="Import IELTop JSON, txt, md, csv, docx, or pdf"/>
                        <Button Style="{StaticResource GhostButton}" Content="Export shown" Margin="0,0,8,8"
                                Command="{Binding Library.ExportShownCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open export folder" Margin="0,0,8,8"
                                Command="{Binding Library.OpenExportFolderCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Library.LibrarySummary}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Library.StatusMessage}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Import and create" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Import a standard paper, paste text, or build in the Editor with fields. Text files work offline. AI drafts need a model in Settings. Always review before saving."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Skill for plain text:" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,8"/>
                                <ComboBox ItemsSource="{Binding Library.DraftSkills}" SelectedItem="{Binding Library.DraftSkill}"
                                          Padding="8" Margin="0,0,8,8" MinWidth="130"
                                          ToolTip="Skill used for plain text imports"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Import files" Margin="0,0,8,8"
                                        Command="{Binding Library.ImportPapersCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="New paper" Margin="0,0,8,8"
                                        Command="{Binding Library.NewPaperCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Open editor" Margin="0,0,8,8"
                                        Command="{Binding Library.OpenEditorCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Stop AI" Margin="0,0,8,8"
                                        Command="{Binding Library.CancelAiCommand}"
                                        IsEnabled="{Binding Library.IsBusy}"/>
                                <hc:LoadingCircle IsRunning="{Binding Library.IsBusy}"
                                                  Visibility="{Binding Library.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <Expander Header="Paste text" IsExpanded="False" Margin="0,4,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBox Padding="8" Margin="0,0,0,6"
                                             hc:InfoElement.Placeholder="Optional title for the new paper"
                                             Text="{Binding Library.DraftTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Text="{Binding Library.PasteText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" Padding="10"
                                             VerticalScrollBarVisibility="Auto" FontSize="13"
                                             hc:InfoElement.Placeholder="Example: paste a reading passage here, then build a draft or ask AI to make questions."/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Save pasted text" Margin="0,0,8,8"
                                                Command="{Binding Library.BuildDraftFromPasteCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="AI format pasted text" Margin="0,0,8,8"
                                                Command="{Binding Library.AiFormatPasteCommand}"
                                                IsEnabled="{Binding Library.CanUseAi}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Read pictures with AI" Margin="0,0,8,8"
                                                Command="{Binding Library.ReadImagesCommand}"
                                                IsEnabled="{Binding Library.CanUseVision}"
                                                ToolTip="Read scans, photos, charts, and Word images with a vision model"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Library.AiHint}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Library.VisionHint}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Review draft JSON" IsExpanded="False" Margin="0,4,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBox Text="{Binding Library.DraftJson, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" Padding="10"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                             hc:InfoElement.Placeholder="AI drafts appear here. For structured editing, use Open in Editor."/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Save draft" Margin="0,0,8,8"
                                                Command="{Binding Library.SaveDraftJsonCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Open in Editor" Margin="0,0,8,8"
                                                Command="{Binding Library.OpenDraftInEditorCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="New blank paper" Margin="0,0,8,8"
                                                Command="{Binding Library.NewManualTemplateCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Prefer the Editor for manual work. The JSON box stays for AI output and quick fixes."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14"
                                    Visibility="{Binding Library.HasRows, Converter={StaticResource InverseBool2Visibility}}">
                                <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                    <TextBlock Text="No papers match" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Filters may hide every paper. Clear them, import a file above, or download from Servers."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Clear filters"
                                            HorizontalAlignment="Center"
                                            Command="{Binding Library.ClearFiltersCommand}"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Library.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardFlat}" Margin="0,0,0,8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                                               TextWrapping="Wrap" Cursor="Hand"
                                                               PreviewMouseMove="PaperDrag_PreviewMouseMove"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Border Style="{StaticResource BadgeGray}"
                                                                Visibility="{Binding Category, Converter={StaticResource String2Visibility}}">
                                                            <TextBlock Text="{Binding Category}" FontSize="11"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeAmber}"
                                                                Visibility="{Binding Level, Converter={StaticResource String2Visibility}}">
                                                            <TextBlock Text="{Binding Level, StringFormat=Band {0}}" FontSize="11"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeGreen}"
                                                                Visibility="{Binding IsUserPaper, Converter={StaticResource Bool2Visibility}}">
                                                            <TextBlock Text="Yours" FontSize="11"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Top" MaxWidth="330">
                                                    <Button Style="{StaticResource GhostButton}" Content="Add" Margin="8,0,6,6"
                                                            Padding="10,4" ToolTip="Add to basket"
                                                            Command="{Binding DataContext.Library.AddToBasketCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Edit" Margin="0,0,6,6"
                                                            Padding="10,4" ToolTip="Open in the editor"
                                                            Command="{Binding DataContext.Library.EditPaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Copy" Margin="0,0,6,6"
                                                            Padding="10,4" ToolTip="Duplicate as your own copy"
                                                            Command="{Binding DataContext.Library.DuplicatePaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="AI check" Margin="0,0,6,6"
                                                            Padding="10,4" ToolTip="Ask the language model to rate this paper"
                                                            Command="{Binding DataContext.Library.AiCheckPaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                    <Button Style="{StaticResource DangerButton}" Content="Delete" Margin="0,0,6,6"
                                                            Padding="10,4" ToolTip="Delete your own paper"
                                                            Visibility="{Binding IsUserPaper, Converter={StaticResource Bool2Visibility}}"
                                                            Command="{Binding DataContext.Library.DeletePaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Start" Padding="12,4" Margin="0,0,0,6"
                                                            Command="{Binding DataContext.Library.StartPaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding Title}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" AllowDrop="True" Drop="Basket_Drop"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Test basket" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Library.BasketLabel}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Library.Basket}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding PaperTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="x"
                                                        Margin="6,0,0,0" Padding="10,4" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.Library.RemoveFromBasketCommand,
                                                            RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Start mixed test" Margin="0,0,8,8"
                                            Command="{Binding Library.StartBasketCommand}"
                                            IsEnabled="{Binding Library.HasBasket}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Clear" Margin="0,0,8,8"
                                            Command="{Binding Library.ClearBasketCommand}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Library.StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ===================== Editor ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Editor}">
                    <TextBlock Text="Editor" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Build papers with fields, not raw JSON. Save, then test the paper in Mock Test."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Paper" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Title" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8"
                                             hc:InfoElement.Placeholder="Example: My Reading Practice 1"
                                             Text="{Binding Editor.PaperTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8"
                                             hc:InfoElement.Placeholder="Academic, General Training, or Imported"
                                             Text="{Binding Editor.Category, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Level band" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0"
                                             hc:InfoElement.Placeholder="Example: 5.0-6.5, optional"
                                             Text="{Binding Editor.Level, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Source" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8"
                                             hc:InfoElement.Placeholder="Where the content comes from"
                                             Text="{Binding Editor.Source, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Tags, comma separated" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0"
                                             hc:InfoElement.Placeholder="Example: reading, nature, practice"
                                             Text="{Binding Editor.TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save paper" Margin="0,0,8,8"
                                        Command="{Binding Editor.SaveCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Validate" Margin="0,0,8,8"
                                        Command="{Binding Editor.ValidateCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Test this paper" Margin="0,0,8,8"
                                        Command="{Binding Editor.TestPaperCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Duplicate" Margin="0,0,8,8"
                                        Command="{Binding Editor.DuplicateCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="New paper" Margin="0,0,8,8"
                                        Command="{Binding Editor.NewPaperCommand}"/>
                                <Button Style="{StaticResource DangerButton}" Content="Delete" Margin="0,0,8,8"
                                        Command="{Binding Editor.DeleteCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Editor.ValidationSummary}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Editor.ValidationIssues}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Editor.StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Parts" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource GhostButton}" Content="Add Listening" Margin="0,0,8,8"
                                        Command="{Binding Editor.AddPartCommand}" CommandParameter="Listening"/>
                                <Button Style="{StaticResource GhostButton}" Content="Add Reading" Margin="0,0,8,8"
                                        Command="{Binding Editor.AddPartCommand}" CommandParameter="Reading"/>
                                <Button Style="{StaticResource GhostButton}" Content="Add Writing" Margin="0,0,8,8"
                                        Command="{Binding Editor.AddPartCommand}" CommandParameter="Writing"/>
                                <Button Style="{StaticResource GhostButton}" Content="Add Speaking" Margin="0,0,8,8"
                                        Command="{Binding Editor.AddPartCommand}" CommandParameter="Speaking"/>
                                <Button Style="{StaticResource GhostButton}" Content="Import file into part" Margin="0,0,8,8"
                                        Command="{Binding Editor.ImportFileIntoPartCommand}"/>
                            </WrapPanel>
                            <ComboBox ItemsSource="{Binding Editor.Parts}" SelectedItem="{Binding Editor.SelectedPart}"
                                      DisplayMemberPath="Summary" Padding="8" Margin="0,0,0,8"
                                      hc:InfoElement.Placeholder="Choose a part to edit"/>
                            <Grid Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Part ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedPart.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Skill" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding Editor.Skills}" SelectedItem="{Binding Editor.SelectedPart.Skill}"
                                              Padding="8" Margin="0,2,0,8"/>
                                    <TextBlock Text="Part title" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedPart.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Minutes" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0" Text="{Binding Editor.SelectedPart.Minutes, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Topic" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedPart.Topic, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Task type" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8"
                                             hc:InfoElement.Placeholder="Example: Passage 1, Task 2 Opinion, Part 1"
                                             Text="{Binding Editor.SelectedPart.TaskType, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Audio file, optional" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0"
                                             hc:InfoElement.Placeholder="Example: clip01.mp3 in the Audio folder"
                                             Text="{Binding Editor.SelectedPart.AudioFile, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Instructions" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}"/>
                            <TextBox Padding="8" Margin="0,2,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"
                                     Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}"
                                     Text="{Binding Editor.SelectedPart.Instructions, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Material, passage or task" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}"/>
                            <TextBox Padding="10" Margin="0,2,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120"
                                     VerticalScrollBarVisibility="Auto" FontSize="13"
                                     Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}"
                                     hc:InfoElement.Placeholder="Paste the passage, transcript, or task here."
                                     Text="{Binding Editor.SelectedPart.Material, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}">
                                <Button Style="{StaticResource DangerButton}" Content="Remove this part" Margin="0,0,8,0"
                                        Command="{Binding Editor.RemovePartCommand}"
                                        CommandParameter="{Binding Editor.SelectedPart}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Editor.HasParts, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Questions" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Writing and Speaking parts need no questions. Listening and Reading do."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add question" Margin="0,0,8,8"
                                        Command="{Binding Editor.AddQuestionCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Remove selected" Margin="0,0,8,8"
                                        Command="{Binding Editor.RemoveQuestionCommand}"
                                        CommandParameter="{Binding Editor.SelectedQuestion}"/>
                            </WrapPanel>
                            <ComboBox ItemsSource="{Binding Editor.SelectedPart.Questions}" SelectedItem="{Binding Editor.SelectedQuestion}"
                                      DisplayMemberPath="Summary" Padding="8" Margin="0,0,0,8"
                                      hc:InfoElement.Placeholder="Choose a question to edit"/>
                            <Grid Visibility="{Binding Editor.HasQuestions, Converter={StaticResource Bool2Visibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Number" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedQuestion.Number, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Kind" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding Editor.Kinds}" SelectedItem="{Binding Editor.SelectedQuestion.Kind}"
                                              Padding="8" Margin="0,2,0,8"/>
                                    <TextBlock Text="Prompt" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                             Text="{Binding Editor.SelectedQuestion.Prompt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Explanation, shown in Reading review" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"
                                             Text="{Binding Editor.SelectedQuestion.Explanation, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Options, one per line as A. text" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" AcceptsReturn="True" MinHeight="80"
                                             Text="{Binding Editor.SelectedQuestion.OptionsText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Correct key" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedQuestion.CorrectKey, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Gap answers, split with |" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" Text="{Binding Editor.SelectedQuestion.GapAnswer, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Match bank, one item per line" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,8" AcceptsReturn="True" MinHeight="50"
                                             Text="{Binding Editor.SelectedQuestion.BankText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Match rows, one per line as label arrow answer" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Padding="8" Margin="0,2,0,0" AcceptsReturn="True" MinHeight="50"
                                             hc:InfoElement.Placeholder="Example: Old measure arrow Road capacity"
                                             Text="{Binding Editor.SelectedQuestion.MatchRowsText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Draft from text and pictures" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Editor.AiHint}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Editor.VisionHint}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Editor.Skills}" SelectedItem="{Binding Editor.PasteSkill}"
                                      Padding="8" Margin="0,0,0,8" MaxWidth="220" HorizontalAlignment="Left"/>
                            <TextBox Padding="10" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"
                                     VerticalScrollBarVisibility="Auto" FontSize="13"
                                     hc:InfoElement.Placeholder="Paste a passage here, then build it into the current part or ask AI for a full draft."
                                     Text="{Binding Editor.PasteText, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Put text into current part" Margin="0,0,8,8"
                                        Command="{Binding Editor.BuildPartFromPasteCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="AI draft full paper" Margin="0,0,8,8"
                                        Command="{Binding Editor.AiDraftCommand}"
                                        IsEnabled="{Binding Editor.CanUseAi}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Read pictures into part" Margin="0,0,8,8"
                                        Command="{Binding Editor.ReadImageIntoPartCommand}"
                                        IsEnabled="{Binding Editor.CanUseVision}"
                                        ToolTip="Read scans, photos, charts, and Word images with a vision model"/>
                                <Button Style="{StaticResource GhostButton}" Content="Stop AI" Margin="0,0,8,8"
                                        Command="{Binding Editor.CancelAiCommand}"
                                        IsEnabled="{Binding Editor.IsBusy}"/>
                                <hc:LoadingCircle IsRunning="{Binding Editor.IsBusy}"
                                                  Visibility="{Binding Editor.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Results ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Results}">
                    <TextBlock Text="Results" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Results.SummaryLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding Results.HasAttempts, Converter={StaticResource InverseBool2Visibility}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12">
                            <TextBlock Text="No tests yet" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Finish a mock test and your band ranges will appear here."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="0,6,0,12"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Start a Mock Test"
                                    HorizontalAlignment="Center" Command="{Binding GoExamCommand}"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Results.ScopeFilters}" SelectedItem="{Binding Results.ScopeFilter}"
                                  Padding="8" Margin="0,0,8,8" MinWidth="150"/>
                        <TextBox Padding="8" Margin="0,0,8,8" MinWidth="200"
                                 hc:InfoElement.Placeholder="Search by paper title"
                                 Text="{Binding Results.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Reload" Margin="0,0,8,8" Command="{Binding Results.LoadCommand}"/>
                        <Button Style="{StaticResource DangerButton}" Content="Clear all" Margin="0,0,8,8" Command="{Binding Results.ClearAllCommand}"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Results.FilteredAttempts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PaperTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource BadgeRed}" Margin="8,0,0,0"
                                                    Visibility="{Binding Violations, Converter={StaticResource Count2Visibility}}">
                                                <TextBlock Text="{Binding Violations, StringFormat={}{0} focus left}" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding Scope}"/><Run Text=" | "/><Run Text="{Binding Strictness}"/><Run Text=" | "/><Run Text="{Binding CreatedAt}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0">
                                            <Run Text="{Binding BandLow, StringFormat={}{0:0.0}}"/><Run Text=" to "/><Run Text="{Binding BandHigh, StringFormat={}{0:0.0}}"/>
                                        </TextBlock>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource BadgeGreen}" Margin="0,0,6,0"
                                                    Visibility="{Binding WritingBand, Converter={StaticResource Count2Visibility}}">
                                                <TextBlock Text="{Binding WritingBand, StringFormat=Writing band {0:0.0}}" FontSize="11"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeGreen}" Margin="0,0,6,0"
                                                    Visibility="{Binding SpeakingBand, Converter={StaticResource Count2Visibility}}">
                                                <TextBlock Text="{Binding SpeakingBand, StringFormat=Speaking band {0:0.0}}" FontSize="11"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Expander Header="AI feedback from this run" Margin="0,6,0,0" IsExpanded="False"
                                                  Visibility="{Binding AiFeedback, Converter={StaticResource String2Visibility}}">
                                            <TextBlock Text="{Binding AiFeedback}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Official criteria" Margin="0,12,0,0" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding Results.CriteriaHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Writing bands" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding Results.WritingTable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Speaking bands" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Results.SpeakingTable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="All bands are practice estimates, not official IELTS scores." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- ===================== Servers ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Servers}">
                    <TextBlock Text="Servers" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Download mock test papers from community or private servers. Saved papers appear in Mock Test."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="Content servers" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Servers.Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardFlat}" Margin="0,0,0,8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Connect" Margin="0,0,8,0"
                                                                Padding="12,6"
                                                                Command="{Binding DataContext.Servers.ConnectToCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Refresh list" Margin="0,0,8,8"
                                            Command="{Binding Servers.RefreshServersCommand}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Remove saved" Margin="0,0,8,8"
                                            Command="{Binding Servers.RemoveServerCommand}"/>
                                </WrapPanel>

                                <Expander Header="Add a new server" Margin="0,12,0,0" IsExpanded="False">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBox Margin="0,0,0,6" Padding="8" hc:InfoElement.Placeholder="Name, for example My Class Server"
                                                 Text="{Binding Servers.NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Margin="0,0,0,6" Padding="8" hc:InfoElement.Placeholder="http://localhost:8765"
                                                 Text="{Binding Servers.NewUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox ItemsSource="{Binding Servers.AuthModes}" SelectedItem="{Binding Servers.SelectedAuthMode}"
                                                  Padding="8" Margin="0,0,0,6"/>
                                        <TextBox Margin="0,0,0,6" Padding="8" hc:InfoElement.Placeholder="Username, for login servers"
                                                 Text="{Binding Servers.Username, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Margin="0,0,0,6" Padding="8" hc:InfoElement.Placeholder="Access code or password"
                                                 Text="{Binding Servers.Secret, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Content="Allow self signed certificate (https only)" Margin="0,0,0,6"
                                                  IsChecked="{Binding Servers.AllowInsecure}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Add server" Margin="0,4,0,0"
                                                HorizontalAlignment="Left" Command="{Binding Servers.AddServerCommand}"/>
                                        <TextBlock Text="Codes and passwords stay encrypted on this computer."
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Papers" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Servers.ServerInfo}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Connect" Margin="0,0,8,10"
                                        HorizontalAlignment="Left" Command="{Binding Servers.ConnectCommand}"
                                        IsEnabled="{Binding Servers.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Style="{StaticResource GhostButton}" Content="Download all listed" Margin="0,0,8,0"
                                            Command="{Binding Servers.DownloadAllCommand}"
                                            IsEnabled="{Binding Servers.IsBusy, Converter={StaticResource InverseBool}}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Stop" Margin="0,0,8,0"
                                            Command="{Binding Servers.CancelCommand}"
                                            IsEnabled="{Binding Servers.IsBusy}"/>
                                </WrapPanel>
                                <TextBox Margin="0,0,0,6" Padding="8" hc:InfoElement.Placeholder="Search papers by title"
                                         Text="{Binding Servers.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox ItemsSource="{Binding Servers.Categories}" SelectedItem="{Binding Servers.SelectedCategory}"
                                          Padding="8" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Servers.Papers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardFlat}" Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource BadgeGreen}" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource Bool2Visibility}}">
                                                                <TextBlock Text="Downloaded" FontSize="11"/>
                                                            </Border>
                                                            <Border Style="{StaticResource BadgeAmber}" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource Bool2Visibility}}">
                                                                <TextBlock Text="Update available" FontSize="11"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Save"
                                                            VerticalAlignment="Top" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.Servers.DownloadPaperCommand,
                                                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <hc:LoadingCircle IsRunning="{Binding Servers.IsBusy}"
                                                      Visibility="{Binding Servers.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                      Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Servers.StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ===================== Settings ===================== -->
                <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Settings}">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Language model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Optional. Works with any server that speaks the OpenAI chat completions API, such as OpenAI, Ollama, LM Studio, llama.cpp server or vLLM. It marks Writing and Speaking, explains wrong Listening and Reading answers, suggests topics, checks papers, and drafts new papers."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Base URL" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="https://api.openai.com/v1"
                                     Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Model name" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,10" Padding="8" hc:InfoElement.Placeholder="gpt-4o-mini or llama3.1"
                                     Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="API key (leave empty for a local server)" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,6" Padding="8" hc:InfoElement.Placeholder="sk-..."
                                     Text="{Binding Settings.ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="The key is stored encrypted on this computer with Windows data protection."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Temperature" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="0" Maximum="2" Increment="0.1" DecimalPlaces="1"
                                                      Value="{Binding Settings.Temperature}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Max reply length" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="64" Maximum="8192" Increment="64" DecimalPlaces="0"
                                                      Value="{Binding Settings.MaxTokens}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Top P sampling, 0 to 1" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="0.1" Maximum="1" Increment="0.05" DecimalPlaces="2"
                                                      Value="{Binding Settings.TopP}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Timeout in seconds" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <hc:NumericUpDown Minimum="15" Maximum="300" Increment="15" DecimalPlaces="0"
                                                      Value="{Binding Settings.TimeoutSeconds}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Lower Top P gives more focused marking. Longer timeout helps slow local servers."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Expander Header="Custom examiner prompt, optional" IsExpanded="False" Margin="0,10,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBox Padding="10" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                             VerticalScrollBarVisibility="Auto" FontSize="13"
                                             hc:InfoElement.Placeholder="Leave empty for the built in IELTS examiner prompt."
                                             Text="{Binding Settings.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Used for every AI call: marking, explanations, topics, and drafts."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>

                            <CheckBox Content="Stream replies as they are written" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.UseStreaming}"/>
                            <CheckBox Content="This model can read images (vision)" Margin="0,6,0,0"
                                      IsChecked="{Binding Settings.VisionEnabled}"/>
                            <TextBlock Text="Turn on vision only if the model supports it, for example gpt-4o or llava. Vision reads pictures from scans, photos, charts, and Word images during import."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <CheckBox Content="Keep offline models ready when a feature starts" Margin="0,10,0,0"
                                      IsChecked="{Binding Settings.ModelAutoLoad}"/>
                            <TextBlock Text="On: writing and speaking models load when Grade with AI starts, then unload after. Off: each model loads on first use and stays until you unload it."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Settings.ModelModeSummary}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Check" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Settings.CheckSummary}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Settings.Problems}" Margin="0,8,0,0"
                                                  Visibility="{Binding Settings.HasProblems, Converter={StaticResource Bool2Visibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,8,8"
                                        Command="{Binding Settings.SaveCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Test connection" Margin="0,0,8,8"
                                        Command="{Binding Settings.TestConnectionCommand}"
                                        IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <hc:LoadingCircle IsRunning="{Binding Settings.IsBusy}"
                                                  Visibility="{Binding Settings.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding Settings.StatusMessage}" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                    Visibility="{Binding Settings.HasDebugDetails, Converter={StaticResource Bool2Visibility}}">
                                <StackPanel>
                                    <TextBlock Text="Connection details" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Settings.DebugDetails}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="What works without a model" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Mock Test always works offline. AI bands, Listening and Reading explanations, topic ideas, and drafts stay disabled until a model is set here."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="#EEF2FF" BorderBrush="#C7D2FE">
                        <StackPanel>
                            <TextBlock Text="Example local setups" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Ollama: base URL http://localhost:11434/v1, model llama3.1, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="LM Studio: base URL http://localhost:1234/v1, model from the loaded server, key empty."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="OpenAI: base URL https://api.openai.com/v1, model gpt-4o-mini, key required."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Exam text size" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding Settings.TextSizeOptions}" SelectedItem="{Binding Settings.SelectedTextSize}"
                                      Padding="8" Margin="0,2,0,0" MaxWidth="220" HorizontalAlignment="Left"/>
                            <TextBlock Text="Large makes test passages, questions and answers bigger, like the real test setting."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <CheckBox Content="Open a test in full screen" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.FullscreenOnStart}"/>
                            <TextBlock Text="{Binding Settings.FullscreenSummary}"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Strict mode is a separate choice in Mock Test step 2. It locks the window and blocks risky keys."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Settings.AppVersion, StringFormat=IELTop version {0}}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Settings.DataFolder, StringFormat=Data folder: {0}}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Open data folder" Margin="0,0,8,8"
                                        Command="{Binding Settings.OpenDataFolderCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Compact database" Margin="0,0,8,8"
                                        Command="{Binding Settings.CompactDatabaseCommand}"/>
                                <Button Style="{StaticResource DangerButton}" Content="Reset settings" Margin="0,0,8,8"
                                        Command="{Binding Settings.ResetSettingsCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="Compact removes old speaking attempts and shrinks the database file. Results history is kept."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Settings.InstallKindLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Settings.AppVersionLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="Update feed URL, optional" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Margin="0,2,0,4" Padding="8"
                                     hc:InfoElement.Placeholder="https://example.com/ieltop/updates or a GitHub Releases URL"
                                     Text="{Binding Settings.UpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Static folder of Velopack release files, or a GitHub Releases page. Empty keeps updates off."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <CheckBox Content="Check for updates when the app starts" Margin="0,0,0,8"
                                      IsChecked="{Binding Settings.UpdateCheckOnStartup}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Content="Check for updates" Margin="0,0,8,8"
                                        Command="{Binding Settings.CheckForUpdatesCommand}"
                                        IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Download update" Margin="0,0,8,8"
                                        Visibility="{Binding Settings.UpdateAvailable, Converter={StaticResource Bool2Visibility}}"
                                        Command="{Binding Settings.DownloadUpdateCommand}"
                                        IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Restart to update" Margin="0,0,8,8"
                                        Visibility="{Binding Settings.UpdateDownloaded, Converter={StaticResource Bool2Visibility}}"
                                        Command="{Binding Settings.RestartToUpdateCommand}"/>
                                <hc:LoadingCircle IsRunning="{Binding Settings.IsBusy}"
                                                  Visibility="{Binding Settings.IsBusy, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Settings.UpdateStatus}" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="System models" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Offline AI files. Load one before its feature, unload to free RAM. Missing files are fine."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ModelsFolder}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LoadedMemory}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Unload all" Margin="0,0,8,0"
                                        Padding="10,4" Command="{Binding UnloadAllModelsCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Refresh" Margin="0,0,8,0"
                                        Padding="10,4" Command="{Binding RefreshStatsCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource String2Visibility}}"/>
                            <ItemsControl ItemsSource="{Binding Models}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding State}" FontSize="11" Margin="8,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                                                    <Border Style="{StaticResource BadgeGreen}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsLoaded, Converter={StaticResource Bool2Visibility}}">
                                                        <TextBlock Text="In memory" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding Message, Converter={StaticResource String2Visibility}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButton}" Content="Load" Margin="0,0,6,0"
                                                        IsEnabled="{Binding IsReady}"
                                                        Command="{Binding LoadCommand}"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Unload"
                                                        IsEnabled="{Binding IsLoaded}"
                                                        Command="{Binding UnloadCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
