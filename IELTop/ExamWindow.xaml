<Window x:Class="IELTop.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:IELTop.Styles"
        Title="IELTop, test in progress" Height="820" Width="1280"
        MinHeight="680" MinWidth="1080"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Exam accent. The real test uses a blue for active controls, so
             the exam window keeps its own blue and leaves the rest of the app
             untouched. -->
        <SolidColorBrush x:Key="ExamAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="ExamAccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="ExamBarBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ExamBarHoverBrush" Color="#D1D5DB"/>

        <!-- Question number tile. State follows the real test: answered is a
             gray fill, the question in view gets a dark border, and a question
             marked for review turns from a square into a circle. -->
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </DataTrigger>
                            <!-- Review flips the square into a circle. -->
                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                <Setter TargetName="Tile" Property="CornerRadius" Value="17"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#111827"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Part tab on the gray bar. The current part is a blue tile. -->
        <Style x:Key="TimerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ExamBarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExamPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ExamAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ExamAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7CBD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The card of the question the student is working on, with a dark
             border so the current question stands out in a full page of them. -->
        <Style x:Key="ExamQuestionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ExamAccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PartTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExamAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ExamAccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ExamQuestionTemplate">
            <Border Style="{StaticResource ExamQuestionCard}" Margin="0,0,0,10" Padding="16"
                    local:BringIntoView.When="{Binding IsFocused}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource ExamAccentBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Content="{Binding FlagLabel}" FontSize="12"
                                  IsChecked="{Binding IsFlagged}"/>
                    </Grid>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,4,0,10"
                               FontSize="{Binding DataContext.Exam.FontScale, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource ScaleFont}, ConverterParameter=14}"/>
                    <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Bool2Visibility}}">
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Text}" Margin="0,3"
                                                 FontSize="{Binding DataContext.Exam.FontScale, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
                                                 GroupName="{Binding GroupName}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsGap, Converter={StaticResource Bool2Visibility}}">
                        <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="14" MaxLength="60"
                                 hc:InfoElement.Placeholder="Type your answer here."/>
                        <TextBlock Text="Write no more than the word limit in the instructions. Spelling must be correct."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsMatch, Converter={StaticResource Bool2Visibility}}">
                        <TextBlock Text="Drag each item into its gap." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Bank}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                                            CornerRadius="8" Padding="10,6" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="13" Cursor="Hand"
                                                   PreviewMouseMove="BankItem_PreviewMouseMove"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MatchRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        <Border Grid.Column="1" AllowDrop="True" Drop="Gap_Drop"
                                                MinWidth="140" MinHeight="32" CornerRadius="8" Padding="8,4"
                                                Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Selected}" FontSize="13" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="x"
                                                Margin="6,0,0,0" Padding="10,4" Click="ClearRow_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuestionNavigator">
            <StackPanel>
                <TextBlock Text="{Binding ProgressLabel}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <ContentControl Content="{Binding FocusedQuestion}"
                                ContentTemplate="{StaticResource ExamQuestionTemplate}"/>
                <WrapPanel Margin="0,2,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Previous question" Margin="0,0,8,8"
                            Command="{Binding DataContext.Exam.PreviousQuestionCommand,
                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            IsEnabled="{Binding CanQuestionBack}"/>
                    <Button Style="{StaticResource GhostButton}" Content="Next question" Margin="0,0,8,8"
                            Command="{Binding DataContext.Exam.NextQuestionCommand,
                                RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            IsEnabled="{Binding CanQuestionNext}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Exam top bar, modeled on the real test: a light gray strip with
             the skill name on the left, the countdown in the middle, and the
             settings tools plus volume on the right. -->
        <Border Grid.Row="0" Background="{StaticResource ExamBarBrush}" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid Margin="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Exam.CurrentPart.Title}" Foreground="#111827"
                                   FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Exam.CurrentPart.HeaderLine}" Foreground="#4B5563"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Countdown. Click the time to hide it, click again to
                         show it. Black by default, red when time runs short. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Button Style="{StaticResource TimerButton}"
                                Command="{Binding Exam.ToggleTimerCommand}"
                                ToolTip="Click to hide or show the timer">
                            <Grid>
                                <TextBlock Text="{Binding Exam.CurrentPart.RemainingLabel}"
                                           FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Visibility="{Binding Exam.CurrentPart.TimerHidden, Converter={StaticResource InverseBool2Visibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#111827"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exam.CurrentPart.IsLowTime}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Exam.CurrentPart.IsCriticalTime}" Value="True">
                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Show time" FontSize="13" Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Exam.CurrentPart.TimerHidden, Converter={StaticResource Bool2Visibility}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Volume  " Foreground="#4B5563" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Exam.Volume}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button Style="{StaticResource TimerButton}" Content="A-" FontSize="15" FontWeight="SemiBold"
                                Command="{Binding Exam.SmallerTextCommand}" ToolTip="Smaller text"/>
                        <Button Style="{StaticResource TimerButton}" Content="A+" FontSize="15" FontWeight="SemiBold"
                                Command="{Binding Exam.BiggerTextCommand}" ToolTip="Larger text"/>
                        <Button Style="{StaticResource TimerButton}" Content="Contrast" FontSize="12"
                                Command="{Binding Exam.ToggleContrastCommand}" ToolTip="Yellow text on a black background"/>
                        <Button Style="{StaticResource TimerButton}" Content="Notes" FontSize="12"
                                Command="{Binding Exam.OpenNotesCommand}" ToolTip="Open a note next to the passage"/>
                        <Button Style="{StaticResource TimerButton}" Content="Full screen" FontSize="12"
                                Command="{Binding Exam.ToggleFullscreenCommand}"
                                ToolTip="Full screen for focus, no strict rules"/>
                        <Button Style="{StaticResource TimerButton}" Content="Strict" FontSize="12"
                                Command="{Binding Exam.ToggleStrictCommand}"
                                ToolTip="Turn the strict exam lock off or on"/>
                        <Border Background="#7F1D1D" CornerRadius="12" Padding="8,3" Margin="8,0,10,0"
                                Visibility="{Binding Exam.StrictMode, Converter={StaticResource Bool2Visibility}}">
                            <TextBlock Text="Strict" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button Style="{StaticResource ExamPrimaryButton}" Content="Submit test" Padding="18,8"
                                FontSize="14" Command="{Binding Exam.SubmitExamCommand}"/>
                    </StackPanel>
                </Grid>
                <Border Background="#7F1D1D" Padding="20,8"
                        Visibility="{Binding Exam.HasViolations, Converter={StaticResource Bool2Visibility}}">
                    <TextBlock Text="{Binding Exam.ViolationLabel}" Foreground="White"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Test content. Full width, so the exam uses the whole screen
             instead of leaving wide empty margins on both sides. -->
        <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto" x:Name="ExamScroll">
            <StackPanel HorizontalAlignment="Stretch">

                    <StackPanel Visibility="{Binding Exam.IsRunning, Converter={StaticResource Bool2Visibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.Instructions, Converter={StaticResource String2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Exam.CurrentPart.Instructions}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Speaking runs without pause. Record once, then finish the part."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Exam.CurrentPart.IsSpeaking, Converter={StaticResource Bool2Visibility}}"/>
                                        <TextBlock Text="The clip plays once and does not replay, like the real test."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Reading split screen: passage on the left, questions on the right, each with its own scroll -->
                                <Grid MinHeight="520"
                                      Visibility="{Binding Exam.CurrentPart.IsReading, Converter={StaticResource Bool2Visibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                                <Button Style="{StaticResource GhostButton}" Content="Highlight" Margin="0,0,8,0"
                                                        Padding="10,4" Click="HighlightButton_Click"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Clear" Margin="0,0,8,0"
                                                        Padding="10,4" Click="ClearHighlightButton_Click"/>
                                                <TextBlock Text="Select text, right click for Highlight or Notes, or press Notes above." FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </WrapPanel>
                                            <Border Grid.Row="1" x:Name="PassageSurface">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Exam.CurrentPart.ContrastOn}" Value="True">
                                                                <Setter Property="Background" Value="#000000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <RichTextBox x:Name="PassageBox" local:RichText.Text="{Binding Exam.CurrentPart.Material}"
                                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             FontSize="{Binding DataContext.Exam.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
                                                             VerticalScrollBarVisibility="Auto">
                                                    <RichTextBox.Style>
                                                        <Style TargetType="RichTextBox">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Exam.CurrentPart.ContrastOn}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FDE047"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </RichTextBox.Style>
                                                    <RichTextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Highlight" Click="HighlightButton_Click"/>
                                                            <MenuItem Header="Clear highlights" Click="ClearHighlightButton_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="Notes" Click="NotesMenu_Click"/>
                                                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                                        </ContextMenu>
                                                    </RichTextBox.ContextMenu>
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="Paragraph">
                                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1" Margin="7,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Exam.CurrentPart.ProgressLabel}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Exam.CurrentPart.Questions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Content="{Binding}"
                                                                            ContentTemplate="{StaticResource ExamQuestionTemplate}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                        <!-- Notes panel: a note sticks next to the sentence it was taken from -->
                                        <Border Grid.Column="1" Width="230" Margin="8,0,0,0"
                                                Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10"
                                                Visibility="{Binding Exam.CurrentPart.NotesOpen, Converter={StaticResource Bool2Visibility}}">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="13"/>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Close"
                                                            Padding="8,2" FontSize="11" Click="CloseNotes_Click"/>
                                                </Grid>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0"
                                                            Visibility="{Binding Exam.CurrentPart.SelectedMaterialWord, Converter={StaticResource String2Visibility}}">
                                                    <TextBlock Text="From the passage:" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Exam.CurrentPart.SelectedMaterialWord}"
                                                               TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                                                               Foreground="#92400E"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding Exam.CurrentPart.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="8" Margin="0,8,0,0"
                                                         VerticalScrollBarVisibility="Auto" FontSize="12"
                                                         Background="White" BorderBrush="#FDE68A"
                                                         SpellCheck.IsEnabled="False"
                                                         hc:InfoElement.Placeholder="Write your note here."/>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Listening audio card: no transcript on screen while it plays -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Audio" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel Margin="0,0,0,8"
                                                   Visibility="{Binding Exam.CurrentPart.ShowStartNow, Converter={StaticResource Bool2Visibility}}">
                                            <Button Style="{StaticResource ExamPrimaryButton}" Content="Start now" Margin="0,0,8,0"
                                                    Command="{Binding Exam.SkipPrepCommand}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Exam.CurrentPart.AudioStatus}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                                Visibility="{Binding Exam.CurrentPart.NoAudioFallback, Converter={StaticResource Bool2Visibility}}">
                                            <TextBlock Text="{Binding Exam.CurrentPart.Material}" TextWrapping="Wrap"
                                                       FontSize="{Binding Exam.FontScale, Converter={StaticResource ScaleFont}, ConverterParameter=13}"/>
                                        </Border>
                                        <TextBlock Text="Listen carefully. The transcript appears in the review after submit."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Writing split screen: task on the left, answer box on the right, each with its own scroll -->
                                <Grid MinHeight="540"
                                      Visibility="{Binding Exam.CurrentPart.IsWriting, Converter={StaticResource Bool2Visibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Task" Style="{StaticResource SectionTitle}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Exam.CurrentPart.Material}" TextWrapping="Wrap"
                                                               FontSize="{Binding Exam.FontScale, Converter={StaticResource ScaleFont}, ConverterParameter=15}"/>
                                                    <TextBlock Text="{Binding Exam.CurrentPart.Instructions}" TextWrapping="Wrap"
                                                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                                                               Visibility="{Binding Exam.CurrentPart.Instructions, Converter={StaticResource String2Visibility}}"/>
                                                    <!-- Task 1 chart or diagram, shown when the paper names an image file -->
                                                    <Border Margin="0,12,0,0" Padding="8" Background="#F9FAFB"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                                            Visibility="{Binding Exam.CurrentPart.HasWritingTask1Image, Converter={StaticResource Bool2Visibility}}">
                                                        <StackPanel>
                                                            <Image Source="{Binding Exam.CurrentPart.WritingImagePath}"
                                                                   Stretch="Uniform" MaxHeight="320"
                                                                   Visibility="{Binding Exam.CurrentPart.HasWritingImageFile, Converter={StaticResource Bool2Visibility}}"/>
                                                            <TextBlock Text="{Binding Exam.CurrentPart.ImageHint}" FontSize="11"
                                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Visibility="{Binding Exam.CurrentPart.HasWritingImageFile, Converter={StaticResource Bool2Visibility}}"/>
                                                            <TextBlock Text="{Binding Exam.CurrentPart.WritingImageName, StringFormat=Missing chart image: {0}. The question still works from the text.}"
                                                                       FontSize="11" Foreground="#B45309" TextWrapping="Wrap"
                                                                       Visibility="{Binding Exam.CurrentPart.ShowMissingImageHint, Converter={StaticResource Bool2Visibility}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Exam.CurrentPart.ImageHint}"
                                                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                               Visibility="{Binding Exam.CurrentPart.ShowNoImageNote, Converter={StaticResource Bool2Visibility}}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Your answer" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Exam.CurrentPart.WordCountLabel}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                            <TextBlock DockPanel.Dock="Bottom" Text="Writing is marked by AI after submit. Bands are ranges for practice."
                                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Border x:Name="WritingSurface">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Exam.CurrentPart.ContrastOn}" Value="True">
                                                                <Setter Property="Background" Value="#000000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox Text="{Binding Exam.CurrentPart.Essay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="10"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontSize="{Binding Exam.FontScale, Converter={StaticResource ScaleFont}, ConverterParameter=15}"
                                                         SpellCheck.IsEnabled="False"
                                                         hc:InfoElement.Placeholder="Write your answer here.">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                            <Setter Property="CaretBrush" Value="#111827"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Exam.CurrentPart.ContrastOn}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FDE047"/>
                                                                    <Setter Property="CaretBrush" Value="#FDE047"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsSpeaking, Converter={StaticResource Bool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Exam.CurrentPart.SpeakingStepLabel}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ExamAccentBrush}" TextWrapping="Wrap"/>

                                        <!-- Cue card: the question the student answers -->
                                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="0,10,0,0"
                                                Visibility="{Binding Exam.CurrentPart.HasMaterial, Converter={StaticResource Bool2Visibility}}">
                                            <StackPanel>
                                                <TextBlock Text="Your cue" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#4338CA"/>
                                                <TextBlock Text="{Binding Exam.CurrentPart.SpeakingCue}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                                           FontSize="{Binding Exam.FontScale, Converter={StaticResource ScaleFont}, ConverterParameter=15}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Record control: big and obvious -->
                                        <Border CornerRadius="10" Padding="16" Margin="0,10,0,0"
                                                Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource ExamPrimaryButton}" Content="Record answer"
                                                            Padding="18,10" FontSize="14" Margin="0,0,10,0"
                                                            Command="{Binding Exam.RecordSpeakingCommand}"
                                                            IsEnabled="{Binding Exam.CurrentPart.IsRecording, Converter={StaticResource InverseBool}}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Finish part"
                                                            Padding="18,10" FontSize="14"
                                                            Command="{Binding Exam.FinishSpeakingPartCommand}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Exam.CurrentPart.RecordingHint}"
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding Exam.CurrentPart.IsRecording, Converter={StaticResource Bool2Visibility}}">
                                                    <Ellipse Width="12" Height="12" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Recording now. Speak clearly, do not pause."
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#B91C1C" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Exam.CurrentPart.AudioStatus}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Transcript: optional, clearly optional -->
                                        <Expander Header="Transcript for AI marking (optional)" Margin="0,10,0,0" IsExpanded="False">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Type or fix what you said so AI can mark your speaking. If transcription already filled this in, just check the words."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Exam.CurrentPart.Transcript, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" Padding="10"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontSize="{Binding Exam.FontScale, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
                                                         hc:InfoElement.Placeholder="Example: I come from Hanoi. I like my hometown because..."/>
                                                <TextBlock Text="{Binding Exam.CurrentPart.TranscriptWordCount}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Listening shows every question of the part at once, like the
                                     real test, so the student reads ahead while the clip plays. -->
                                <ItemsControl ItemsSource="{Binding Exam.CurrentPart.Questions}"
                                              Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource Bool2Visibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ExamQuestionTemplate}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding Exam.CurrentPart.IsReading, Converter={StaticResource InverseBool2Visibility}}">
                                    <StackPanel Visibility="{Binding Exam.CurrentPart.IsListening, Converter={StaticResource InverseBool2Visibility}}">
                                        <ContentControl Content="{Binding Exam.CurrentPart}"
                                                        ContentTemplate="{StaticResource QuestionNavigator}"
                                                        Visibility="{Binding Exam.CurrentPart.HasQuestions, Converter={StaticResource Bool2Visibility}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        Visibility="{Binding Exam.CurrentPart.IsSpeaking, Converter={StaticResource InverseBool2Visibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Notes" Style="{StaticResource SectionTitle}"/>
                                        <TextBox Text="{Binding Exam.CurrentPart.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" Padding="10"
                                                 VerticalScrollBarVisibility="Auto" FontSize="13"
                                                 hc:InfoElement.Placeholder="Scratch notes, like the notes feature of the real test."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Result after submit, shown inside the exam window -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding Exam.ShowResult, Converter={StaticResource Bool2Visibility}}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Exam.BandLabel, StringFormat=Band range: {0}}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource ExamAccentBrush}"
                                       Visibility="{Binding Exam.HasBand, Converter={StaticResource Bool2Visibility}}"/>
                            <TextBlock Text="{Binding Exam.ResultText}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Exam.CriteriaHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource ExamPrimaryButton}" Content="Grade with AI" Margin="0,0,8,8"
                                        Command="{Binding Exam.GradeWithAiCommand}"
                                        IsEnabled="{Binding Exam.CanUseAi}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Stop" Margin="0,0,8,8"
                                        Command="{Binding Exam.CancelGradingCommand}"
                                        IsEnabled="{Binding Exam.IsGrading}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Copy feedback" Margin="0,0,8,8"
                                        Command="{Binding Exam.CopyFeedbackCommand}"
                                        IsEnabled="{Binding Exam.HasAiFeedback}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Show answer review" Margin="0,0,8,8"
                                        Command="{Binding Exam.ToggleReviewCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Back to setup" Margin="0,0,8,8"
                                        Command="{Binding Exam.BackToSetupCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Close window" Margin="0,0,8,8"
                                        Command="{Binding Exam.CloseExamCommand}"/>
                                <hc:LoadingCircle IsRunning="{Binding Exam.IsGrading}"
                                                  Visibility="{Binding Exam.IsGrading, Converter={StaticResource Bool2Visibility}}"
                                                  Width="22" Height="22" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="Grade with AI marks Writing and Speaking with bands, and explains each wrong Listening and Reading answer."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8"
                                    Padding="14" Margin="0,10,0,0"
                                    Visibility="{Binding Exam.IsGrading, Converter={StaticResource Bool2Visibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <hc:LoadingCircle IsRunning="{Binding Exam.IsGrading}" Width="22" Height="22" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Exam.LoadingLabel}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Exam.ModelModeLabel}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Add a language model in Settings for detailed AI bands."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Exam.ShowAiHint, Converter={StaticResource Bool2Visibility}}"/>
                            <ItemsControl ItemsSource="{Binding Exam.AiFeedbackLines}" Margin="0,10,0,0"
                                          Visibility="{Binding Exam.HasAiFeedback, Converter={StaticResource Bool2Visibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Exam.ReviewItems}" Margin="0,10,0,0"
                                          Visibility="{Binding Exam.ShowReview, Converter={StaticResource Bool2Visibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Path Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#15803D" StrokeThickness="2" VerticalAlignment="Center"
                                                  Data="M4,12 L10,18 L20,6">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#B91C1C" StrokeThickness="2" VerticalAlignment="Center"
                                                  Data="M6,6 L18,18 M18,6 L6,18">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGood}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Exam bottom bar: part tabs with the question palette, then the
             back and forward arrows on the right. -->
        <Border Grid.Row="2" Background="{StaticResource ExamBarBrush}" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Exam.Parts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Button Content="{Binding TabLabel}" Style="{StaticResource PartTabButton}"
                                            Command="{Binding DataContext.Exam.GoToPartCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <ItemsControl ItemsSource="{Binding Questions}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PaletteButton}"
                                                        Content="{Binding Model.Number}"
                                                        Command="{Binding DataContext.Exam.GoToGlobalCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Gray: answered. Dark border: this question. Circle: review."
                               FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="◀" Margin="0,0,6,0"
                            Padding="12,6" Command="{Binding Exam.PreviousQuestionCommand}"
                            IsEnabled="{Binding Exam.CurrentPart.CanQuestionBack}"/>
                    <Button Style="{StaticResource GhostButton}" Content="▶" Padding="12,6"
                            Command="{Binding Exam.NextQuestionCommand}"
                            IsEnabled="{Binding Exam.CurrentPart.CanQuestionNext}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
