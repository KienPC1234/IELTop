@page
@model IELTop_Content_Server.Pages.Settings.NotificationsModel
@{
    ViewData["Title"] = "Email settings";
}

<h1 class="h3 mb-3">Email settings</h1>

@if (!Model.Enabled)
{
    <div class="alert alert-warning" role="alert">
        SMTP is off. Contributors will not get emails until you turn it on and fill in the host.
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <form method="post">
            <div class="card mb-3">
                <div class="card-header">Outgoing mail</div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="enabled"
                               name="enabled" value="true" @(Model.Enabled ? "checked" : null) />
                        <label class="form-check-label" for="enabled">Send notification email</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label" for="host">SMTP host</label>
                            <input class="form-control" id="host" name="host" value="@Model.Host"
                                   placeholder="smtp.example.com" />
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="port">Port</label>
                            <input class="form-control" id="port" name="port" type="number"
                                   value="@Model.Port" min="1" max="65535" />
                        </div>
                    </div>
                    <div class="form-check my-3">
                        <input class="form-check-input" type="checkbox" id="tls"
                               name="useStartTls" value="true" @(Model.UseStartTls ? "checked" : null) />
                        <label class="form-check-label" for="tls">Use STARTTLS (port 587)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" id="username" name="username" value="@Model.Username"
                               autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" id="password" name="password" type="password"
                               autocomplete="new-password" />
                        <div class="form-text">
                            Leave blank to keep the stored password. Set it in appsettings for production.
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-7">
                            <label class="form-label" for="fromAddress">From address</label>
                            <input class="form-control" id="fromAddress" name="fromAddress"
                                   value="@Model.FromAddress" />
                        </div>
                        <div class="col-5">
                            <label class="form-label" for="fromName">From name</label>
                            <input class="form-control" id="fromName" name="fromName" value="@Model.FromName" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="baseUrl">Public base URL for links</label>
                        <input class="form-control" id="baseUrl" name="baseUrl" value="@Model.BaseUrl"
                               placeholder="https://content.example.com" />
                    </div>
                </div>
            </div>
            <button class="btn btn-primary" type="submit">Save email settings</button>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header">Send a test</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Test">
                    <div class="mb-3">
                        <label class="form-label" for="testTo">Send to</label>
                        <input class="form-control" id="testTo" name="to" type="email" required
                               value="@Model.FromAddress" />
                    </div>
                    <button class="btn btn-outline-secondary" type="submit">Queue a test email</button>
                    <div class="form-text">
                        The test is queued and delivered by the mail worker within a minute.
                        Check the outbox for the result.
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Runtime review settings</div>
            <div class="card-body">
                <p class="mb-2">
                    Automated review:
                    <span class="badge @(Model.ReviewEnabled ? "text-bg-success" : "text-bg-secondary")">
                        @(Model.ReviewEnabled ? "on" : "off")
                    </span>
                </p>
                <p class="mb-2">
                    Auto reject below score:
                    <strong>@(Model.AutoRejectBelowScore > 0 ? Model.AutoRejectBelowScore.ToString() : "disabled")</strong>
                </p>
                <p class="mb-0 text-muted small">
                    These come from the Llm and Contribute sections in appsettings. A model and its
                    key are secrets, so they are edited on the host, never from this page.
                </p>
            </div>
        </div>
    </div>
</div>
