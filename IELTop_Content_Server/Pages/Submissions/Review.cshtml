@page "{id:int}"
@model IELTop_Content_Server.Pages.Submissions.ReviewModel
@{
    ViewData["Title"] = "Review " + Model.Submission.Reference;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Submission.Title</h1>
        <span class="text-muted">
            <code>@Model.Submission.Reference</code> by @Model.Submission.AuthorName,
            <span class="badge @Format.StatusColor(Model.Submission.Status)">
                @Format.StatusLabel(Model.Submission.Status)
            </span>
        </span>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Submissions/Index">Back to queue</a>
</div>

@if (!string.IsNullOrEmpty(Model.Submission.DecisionReason))
{
    <div class="alert alert-secondary" role="alert">
        <strong>Decision note.</strong> @Model.Submission.DecisionReason
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        @foreach (var file in Model.Files)
        {
            <div class="card mb-3 shadow-sm border">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center py-2 bg-body-tertiary">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(file.Kind == "paper" ? "bg-primary" : file.Kind == "audio" ? "bg-success" : "bg-secondary")">@file.Kind</span>
                        <code class="fw-bold">@file.FileName</code>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge text-bg-light border">@Format.Size(file.SizeBytes)</span>
                        @if (file.HasBinary)
                        {
                            <a class="btn btn-sm btn-outline-secondary py-0 px-2"
                               asp-page="/Submissions/Download" asp-route-fileId="@file.Id">Download</a>
                        }
                    </div>
                </div>

                @if (file.Kind == "paper")
                {
                    <div class="border-bottom px-3 pt-2 bg-body-tertiary">
                        <ul class="nav nav-tabs border-bottom-0" id="fileTab-@file.Id" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-1 px-3 small" id="preview-tab-@file.Id" data-bs-toggle="tab" data-bs-target="#preview-pane-@file.Id" type="button" role="tab">
                                    <i class="bi bi-eye me-1"></i>Exam Preview
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3 small" id="edit-tab-@file.Id" data-bs-toggle="tab" data-bs-target="#edit-pane-@file.Id" type="button" role="tab">
                                    <i class="bi bi-pencil-square me-1"></i>Edit Paper
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3 small" id="source-tab-@file.Id" data-bs-toggle="tab" data-bs-target="#source-pane-@file.Id" type="button" role="tab">
                                    <i class="bi bi-code-slash me-1"></i>Raw Source
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body p-3">
                        <div class="tab-content" id="fileTabContent-@file.Id">
                            <div class="tab-pane fade show active" id="preview-pane-@file.Id" role="tabpanel">
                                @await Html.PartialAsync("_ExamPaperViewer", file.Text)
                            </div>
                            <div class="tab-pane fade" id="edit-pane-@file.Id" role="tabpanel">
                                <form method="post" asp-page-handler="SavePaper">
                                    <input type="hidden" name="id" value="@Model.Submission.Id" />
                                    <input type="hidden" name="fileId" value="@file.Id" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-body-secondary" for="paperContent-@file.Id">
                                            Edit Paper JSON definition:
                                        </label>
                                        <textarea class="form-control font-monospace small" id="paperContent-@file.Id" name="paperContent" rows="18" required style="line-height: 1.5;">@file.Text</textarea>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span class="small text-body-secondary">
                                            <i class="bi bi-info-circle me-1"></i>Changes will be validated against paper schema and saved immediately.
                                        </span>
                                        <button class="btn btn-sm btn-primary" type="submit">
                                            <i class="bi bi-check2-circle me-1"></i>Save Paper Changes
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="source-pane-@file.Id" role="tabpanel">
                                <pre class="small mb-0 p-3 bg-body-tertiary border rounded" style="max-height:35rem;overflow:auto">@file.Text</pre>
                            </div>
                        </div>
                    </div>
                }
                else if (file.Kind == "text")
                {
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-body-secondary fw-semibold">Extracted Document Text:</span>
                        </div>
                        <div class="p-3 border rounded bg-body" style="white-space: pre-wrap; line-height: 1.75; max-height: 30rem; overflow-y: auto;">
                            @file.Text
                        </div>
                    </div>
                }
                else if (file.Kind == "audio")
                {
                    <div class="card-body p-3">
                        <span class="text-body-secondary small d-block mb-2">Listening test audio track:</span>
                        <audio controls class="w-100" preload="metadata">
                            <source src="@Url.Page("/Submissions/Download", new { fileId = file.Id, inline = true })" />
                            Your browser does not support audio playback.
                        </audio>
                    </div>
                }
                else
                {
                    <div class="card-body p-3">
                        <span class="text-muted">Binary file. Download it to inspect.</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header">Author and source</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Author</span><span>@Model.Submission.AuthorName</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Source</span><span class="text-truncate">@Model.Submission.Source</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>License</span><span>@Model.Submission.License</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Submitted</span><span>@Format.When(Model.Submission.CreatedAt)</span>
                </li>
                <li class="list-group-item">
                    <span class="text-muted small">Author note</span>
                    <div>@Model.Submission.Note</div>
                </li>
            </ul>
        </div>

        <div class="card mb-3">
            <div class="card-header">Automated review</div>
            <div class="card-body">
                @if (Model.Submission.ReviewScore >= 0)
                {
                    <p class="mb-2">
                        Score: <strong>@Model.Submission.ReviewScore</strong> / 100
                        @if (Model.Submission.ReviewScore >= 70)
                        {
                            <span class="badge text-bg-success">Strong</span>
                        }
                        else if (Model.Submission.ReviewScore >= 40)
                        {
                            <span class="badge text-bg-warning">Borderline</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Weak</span>
                        }
                    </p>
                }
                else
                {
                    <p class="text-muted">No automated score. A model is not configured or review is off.</p>
                }

                @if (!string.IsNullOrEmpty(Model.Submission.ReviewSummary))
                {
                    <p class="mb-2">@Model.Submission.ReviewSummary</p>
                }

                @if (Model.Problems.Count > 0)
                {
                    <p class="mb-1 fw-semibold">Problems</p>
                    <ul>
                        @foreach (var p in Model.Problems)
                        {
                            <li>@p</li>
                        }
                    </ul>
                }
                @if (Model.Suggestions.Count > 0)
                {
                    <p class="mb-1 fw-semibold">Suggestions</p>
                    <ul class="mb-0">
                        @foreach (var s in Model.Suggestions)
                        {
                            <li>@s</li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (Model.Submission.Status == SubmissionStatus.Accepted)
        {
            <div class="alert alert-success" role="alert">
                Published as <code>@Model.Submission.PaperId</code>.
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header">Accept and publish</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Accept">
                        <div class="mb-2">
                            <label class="form-label" for="extraTags">Add tags</label>
                            <input class="form-control" id="extraTags" name="extraTags"
                                   value="@Model.SuggestedTags"
                                   placeholder="reading, academic, transport" />
                            <div class="form-text">
                                The model's tags are kept. Add or adjust here, comma separated.
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="acceptNote">Note to the author</label>
                            <input class="form-control" id="acceptNote" name="decisionNote" />
                        </div>
                        <button class="btn btn-success w-100" type="submit">Accept and publish</button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Reject</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Reject">
                        <div class="mb-2">
                            <label class="form-label" for="reason">Reason for the author</label>
                            <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                            <div class="form-text">The author gets this by email.</div>
                        </div>
                        <button class="btn btn-outline-danger w-100" type="submit">Reject submission</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
