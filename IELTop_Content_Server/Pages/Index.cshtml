@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-2">
    <!-- Header with Quick Action Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Administrative Overview</h1>
            <p class="text-body-secondary small mb-0">System performance, content lifecycle, and real time user activity.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Health">Health Check</a>
            <a class="btn btn-sm btn-outline-warning" asp-page="/P" asp-route-slug="pro">View Pro Page</a>
            <a class="btn btn-sm btn-outline-danger" asp-page="/Security/Index">Security Shield</a>
            <a class="btn btn-sm btn-primary" asp-page="/Papers/Import">Import Papers</a>
        </div>
    </div>

    <!-- Core Metric Highlights -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-body-secondary small fw-medium">Published Papers</span>
                        <span class="badge bg-primary-subtle text-primary">Catalog</span>
                    </div>
                    <div class="display-6 fw-bold mb-1">@Model.PaperCount</div>
                    <a class="small text-decoration-none fw-semibold" asp-page="/Papers/Index">Manage papers &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-body-secondary small fw-medium">Audio Clips</span>
                        <span class="badge bg-success-subtle text-success">Storage</span>
                    </div>
                    <div class="display-6 fw-bold mb-1">@Model.AudioCount</div>
                    <a class="small text-decoration-none fw-semibold" asp-page="/Audio/Index">Manage audio &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 @(Model.InReview > 0 ? "border-warning bg-warning-subtle" : "border-info")">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-body-secondary small fw-medium">Submissions in Review</span>
                        <span class="badge @(Model.InReview > 0 ? "bg-warning text-dark" : "bg-info-subtle text-info")">Queue</span>
                    </div>
                    <div class="display-6 fw-bold mb-1">@Model.InReview</div>
                    <a class="small text-decoration-none fw-semibold" asp-page="/Submissions/Index">Open review queue &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-secondary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-body-secondary small fw-medium">Editor Applications</span>
                        <span class="badge bg-secondary-subtle text-secondary">Recruitment</span>
                    </div>
                    <div class="display-6 fw-bold mb-1">@Model.PendingEditors</div>
                    <a class="small text-decoration-none fw-semibold" asp-page="/Editors/Index">Review applications &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Performance Counters -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body">
                <div class="card-body p-3">
                    <div class="text-body-secondary small">Total Contributors</div>
                    <div class="h3 fw-bold mb-0">@Model.ContributorCount</div>
                    <small class="text-body-tertiary">Registered accounts</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body">
                <div class="card-body p-3">
                    <div class="text-body-secondary small">API Calls Today</div>
                    <div class="h3 fw-bold mb-0">@Model.TodayApiCalls</div>
                    <small class="text-body-tertiary">Requests handled</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body">
                <div class="card-body p-3">
                    <div class="text-body-secondary small">Paper Downloads Today</div>
                    <div class="h3 fw-bold mb-0">@Model.TodayDownloads</div>
                    <small class="text-body-tertiary">Exams fetched</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body">
                <div class="card-body p-3">
                    <div class="text-body-secondary small">Audio Served Today</div>
                    <div class="h3 fw-bold mb-0">@Model.TodayAudio</div>
                    <small class="text-body-tertiary">Tracks delivered</small>
                </div>
            </div>
        </div>
    </div>

    <!-- System Alerts -->
    @if (!Model.LoginEnabled)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
            <div>Client login is turned off. Desktop apps must authenticate via alternative methods.</div>
        </div>
    }
    @if (!Model.CaptchaEnabled)
    {
        <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
            <div>Cloudflare Turnstile verification is disabled. Enable keys in settings to activate bot defense.</div>
        </div>
    }
    @if (!Model.SmtpEnabled)
    {
        <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
            <div>SMTP outbound service is inactive. Notifications will be queued locally without delivery. <a asp-page="/Settings/Notifications" class="alert-link">Configure mail settings</a>.</div>
        </div>
    }

    <!-- Detailed System & Operational Status -->
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3 fw-bold">
                    Client Connection Information
                </div>
                <div class="card-body">
                    <p class="small text-body-secondary mb-2">Provide this endpoint address to the IELTop desktop client:</p>
                    <div class="input-group mb-3">
                        <input class="form-control font-monospace" readonly value="@Model.BaseUrl" aria-label="Server address" />
                        <a class="btn btn-outline-secondary" asp-page="/Health">Check</a>
                    </div>
                    <div class="mb-3">
                        <span class="text-body-secondary small d-block mb-1">Supported Auth Modes</span>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var mode in Model.AuthModes)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@mode</span>
                            }
                        </div>
                    </div>
                    <div>
                        <span class="text-body-secondary small d-block mb-1">Active Skills Served</span>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge bg-info-subtle text-info border">@skill</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3 fw-bold">
                    Runtime Infrastructure
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Database Provider</span>
                        <span class="badge bg-primary-subtle text-primary">@Model.DatabaseProvider</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Cache Backend</span>
                        <span class="badge bg-success-subtle text-success">@Model.CacheProvider</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Content Version</span>
                        <span class="badge bg-secondary-subtle text-secondary">v@Model.ContentVersion</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Server Uptime</span>
                        <span class="fw-medium">@Model.Uptime</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Working Set Memory</span>
                        <span class="fw-medium">@Model.WorkingSet</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>Outbox Mail Queue</span>
                        <a asp-page="/Notifications/Index" class="fw-bold text-decoration-none">@Model.MailPending pending</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Audit and Activity Feed</span>
                    <a class="small text-decoration-none" asp-page="/Audit/Index">View all &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>Event</th>
                                <th>Target</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                        @foreach (var row in Model.Recent)
                        {
                            <tr>
                                <td class="text-nowrap text-body-secondary">@row.At.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@row.Action</span></td>
                                <td class="text-truncate" style="max-width:11rem" title="@row.Target">@row.Target</td>
                            </tr>
                        }
                        @if (Model.Recent.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-body-secondary py-3">No activity recorded yet.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
