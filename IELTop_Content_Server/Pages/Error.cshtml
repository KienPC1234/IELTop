@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1 class="h3">Something went wrong</h1>
@if (Model.ShowRequestId)
{
    <p class="text-muted">Reference: <code>@Model.RequestId</code></p>
}
<p class="mb-3">
    The page you asked for is not available, or the server could not finish the request.
    Nothing was changed. Try again, or go back to the dashboard.
</p>
<a class="btn btn-primary" asp-page="/Index">Back to the dashboard</a>
