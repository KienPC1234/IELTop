@page
@model IELTop_Content_Server.Pages.Contrib.SignInModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center my-auto py-4">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">Sign in</h1>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" id="email" name="email" type="email" required
                               value="@Model.Email" autocomplete="email" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" id="password" name="password" type="password"
                               required autocomplete="current-password" />
                    </div>

                    @await Html.PartialAsync("_Captcha")

                    <button class="btn btn-primary w-100" type="submit">Sign in</button>
                </form>

                <p class="mt-3 mb-1 small">
                    No account yet? <a asp-page="/Contrib/Register">Create one</a>.
                    Editors sign in here too.
                </p>
                <p class="mb-0 small text-body-secondary">
                    Looking for administrative tools? <a asp-page="/Account/Login" class="text-decoration-none">Admin login</a>.
                </p>
            </div>
        </div>
    </div>
</div>
