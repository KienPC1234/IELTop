@page
@model IELTop_Content_Server.Pages.Contrib.RegisterModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card mt-4">
            <div class="card-body">
                <h1 class="h4 mb-1">Create a contributor account</h1>
                <p class="text-muted small">
                    An account lets you submit practice papers, audio, and texts, and track
                    what happens to them.
                </p>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" id="email" name="email" type="email" required
                               value="@Model.Email" autocomplete="email" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="displayName">Display name</label>
                        <input class="form-control" id="displayName" name="displayName"
                               value="@Model.DisplayName" autocomplete="nickname" />
                        <div class="form-text">Shown on the papers you contribute.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" id="password" name="password" type="password"
                               required minlength="8" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters.</div>
                    </div>

                    @await Html.PartialAsync("_Captcha")

                    <button class="btn btn-primary w-100" type="submit">Create account</button>
                </form>

                <p class="mt-3 mb-0 small">
                    Already have one? <a asp-page="/Contrib/SignIn">Sign in</a>.
                </p>
            </div>
        </div>
    </div>
</div>
