@page
@model IELTop_Content_Server.Pages.Contrib.DashboardModel
@{
    ViewData["Title"] = "My submissions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">My submissions</h1>
        <span class="text-muted">@Model.DisplayName, @Model.Submissions.Count submission(s)</span>
    </div>
    <a class="btn btn-primary" asp-page="/Contrib/Submit">Submit content</a>
</div>

@if (Model.IsEditor)
{
    <div class="alert alert-info" role="alert">
        You are an approved editor. Thank you for helping review the library.
        Open the review queue from the menu when you want to help.
    </div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Reference</th>
            <th>Title</th>
            <th>Status</th>
            <th class="text-end">Review score</th>
            <th>Submitted</th>
            <th>Decision</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Submissions)
        {
            <tr>
                <td><code>@row.Reference</code></td>
                <td>@row.Title</td>
                <td><span class="badge @Format.StatusColor(row.Status)">@Format.StatusLabel(row.Status)</span></td>
                <td class="text-end">@(row.ReviewScore >= 0 ? row.ReviewScore.ToString() : "-")</td>
                <td class="text-nowrap">@Format.When(row.CreatedAt)</td>
                <td class="text-truncate" style="max-width:18rem">@row.DecisionReason</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Contrib/Submission"
                       asp-route-id="@row.Id">View</a>
                    @if (row.Status is SubmissionStatus.Draft or SubmissionStatus.InReview)
                    {
                        <form method="post" asp-page-handler="Withdraw" class="d-inline"
                              onsubmit="return confirm('Withdraw @row.Reference?');">
                            <input type="hidden" name="id" value="@row.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Withdraw</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Submissions.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">You have not submitted anything yet.</td></tr>
        }
        </tbody>
    </table>
</div>
