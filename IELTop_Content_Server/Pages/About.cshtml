@page
@model IELTop_Content_Server.Pages.AboutModel
@{
    ViewData["Title"] = "IELTop Content Platform";
}

<div class="py-4">
    <!-- Hero Banner -->
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-body shadow-sm border border-subtle">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-primary-subtle text-primary border border-primary-subtle small fw-medium">
                    <span class="badge bg-primary rounded-pill">ieltop/1</span>
                    <span>Official Content Distribution Hub</span>
                </div>
                <h1 class="display-5 fw-bold text-body-emphasis mb-3">
                    Master IELTS with Offline Precision
                </h1>
                <p class="lead text-body-secondary mb-4">
                    The central distribution portal for the open source IELTop desktop application. Stream verified mock test papers, studio-grade listening audio, and peer-reviewed materials straight into your offline study environment.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="https://github.com/KienPC1234/IELTop" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-github"></i>
                        Get Desktop App
                    </a>
                    <a asp-page="/P" asp-route-slug="pro" class="btn btn-warning btn-lg px-4 fw-semibold text-dark">
                        Dedicated Server for Centers
                    </a>
                    <a asp-page="/Contrib/Register" class="btn btn-outline-secondary btn-lg px-4">
                        Join as Contributor
                    </a>
                </div>
            </div>
            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card border-0 bg-body-tertiary shadow-sm p-4">
                    <h2 class="h5 mb-3 d-flex align-items-center justify-content-between">
                        <span>Server Telemetry</span>
                        <span class="badge bg-success-subtle text-success">Healthy</span>
                    </h2>
                    <ul class="list-unstyled mb-3">
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-body-secondary">Active Protocol</span>
                            <code class="fw-bold">@Model.Protocol</code>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-body-secondary">Published Exams</span>
                            <span class="fw-semibold">@Model.PaperCount papers</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-body-secondary">Audio Library</span>
                            <span class="fw-semibold">@Model.AudioCount tracks</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-body-secondary">Auth Protocol</span>
                            <span class="text-body-secondary small">@string.Join(", ", Model.AuthModes)</span>
                        </li>
                    </ul>
                    <a asp-page="/Health" class="btn btn-sm btn-outline-secondary w-100">
                        View Detailed Health Check
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Pillars -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm card-hover">
                <div class="card-body p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-primary-subtle text-primary mb-3">
                        <i class="bi bi-laptop fs-4"></i>
                    </div>
                    <h3 class="h5 card-title">True Offline Engine</h3>
                    <p class="card-text text-body-secondary small">
                        All downloaded papers, tests, and audio files stay on your machine. You can practice in complete flight mode without interruptions.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm card-hover">
                <div class="card-body p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-success-subtle text-success mb-3">
                        <i class="bi bi-soundwave fs-4"></i>
                    </div>
                    <h3 class="h5 card-title">Clean Audio Stream</h3>
                    <p class="card-text text-body-secondary small">
                        Crystal clear listening tracks with native accent variations, HTTP byte-range seek capability, and lightweight memory footprint.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm card-hover">
                <div class="card-body p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-info-subtle text-info mb-3">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                    </div>
                    <h3 class="h5 card-title">Peer Quality Review</h3>
                    <p class="card-text text-body-secondary small">
                        Every question and answer explanation passes through automated validation checks followed by certified teacher review.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm border-warning card-hover">
                <div class="card-body p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-warning-subtle text-warning mb-3">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <h3 class="h5 card-title">Dedicated Academy Server</h3>
                    <p class="card-text text-body-secondary small">
                        Deploy an exclusive exam management server for your language center with proprietary test papers, custom audio, and student access codes.
                    </p>
                    <a asp-page="/P" asp-route-slug="pro" class="small fw-semibold text-warning text-decoration-none">
                        Explore Academy Server &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Connection & Quick Setup Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h2 class="h5 mb-0">Connect IELTop Desktop App</h2>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary mb-3">
                        Follow these simple steps to link your desktop app with this content server:
                    </p>
                    <ol class="list-group list-group-numbered list-group-flush mb-4">
                        <li class="list-group-item px-0 py-2 border-0">
                            Launch your <strong>IELTop</strong> desktop client.
                        </li>
                        <li class="list-group-item px-0 py-2 border-0">
                            Navigate to <strong>Settings</strong> or <strong>Servers</strong> in the left sidebar.
                        </li>
                        <li class="list-group-item px-0 py-2 border-0">
                            Paste the server URL below and click <strong>Connect</strong>.
                        </li>
                    </ol>
                    <div class="mb-3">
                        <label class="form-label small text-body-secondary" for="serverUrlInput">Server Endpoint Address</label>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace" id="serverUrlInput" readonly value="@Model.BaseUrl" />
                            <button class="btn btn-outline-secondary" type="button" id="copyUrlBtn">
                                Copy URL
                            </button>
                        </div>
                        <div id="copyFeedback" class="form-text text-success d-none">
                            Server URL copied to clipboard!
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h2 class="h5 mb-0">Contributing Practice Material</h2>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary mb-3">
                        Are you an IELTS teacher, examiner, or content creator? You can submit your original practice tests, passages, and audio recordings to help thousands of learners worldwide.
                    </p>
                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded bg-primary-subtle text-primary">
                                <i class="bi bi-file-earmark-plus fs-5"></i>
                            </div>
                            <div>
                                <h3 class="h6 mb-1">Create Contributor Account</h3>
                                <p class="small text-body-secondary mb-0">Sign up in seconds and gain access to the web submission studio.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded bg-success-subtle text-success">
                                <i class="bi bi-person-check fs-5"></i>
                            </div>
                            <div>
                                <h3 class="h6 mb-1">Apply to Become a Reviewing Editor</h3>
                                <p class="small text-body-secondary mb-0">Qualified instructors can participate in reviewing community submissions.</p>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-page="/Contrib/Register" class="btn btn-outline-primary">Register Now</a>
                        <a asp-page="/Contrib/ApplyEditor" class="btn btn-outline-secondary">Apply as Editor</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Protocol Endpoints Reference -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent py-3">
            <h2 class="h5 mb-0">Protocol Endpoint Reference</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 100px;">Method</th>
                        <th scope="col">Path</th>
                        <th scope="col">Function</th>
                        <th scope="col" style="width: 140px;">Authentication</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-success">GET</span></td>
                        <td><code>/api/health</code></td>
                        <td>Server health status, cache verification, S3 storage connectivity, and operational metrics</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Public</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">GET</span></td>
                        <td><code>/api/info</code></td>
                        <td>Server greeting, capability discovery, supported audio codecs (m4a, opus), and security features</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Public</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">GET</span></td>
                        <td><code>/api/papers</code></td>
                        <td>Filterable catalog of active exam papers with metadata and exclusive paper flags</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Optional</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">GET</span></td>
                        <td><code>/api/papers/{id}</code></td>
                        <td>Paper payload with anti-leak watermarking, optional deferred answer hiding (?mode=exam), and access code checks (?code=...)</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Optional</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">POST</span></td>
                        <td><code>/api/papers/verify-watermark</code></td>
                        <td>Verifies digital HMAC anti-leak watermark and resolves licensee identity from leaked exam papers</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Optional</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">GET</span></td>
                        <td><code>/api/audio/{file}</code></td>
                        <td>Byte-range audio stream for standardized m4a and opus listening test clips hosted on S3 storage</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Public</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">POST</span></td>
                        <td><code>/api/login</code></td>
                        <td>Exchanges user credentials for a secure time-limited token</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Public</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-transparent py-3 text-body-secondary small">
            Estimated scores and band indicators are diagnostic guides for exam preparation and do not constitute official IELTS scores.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('copyUrlBtn')?.addEventListener('click', function() {
            var input = document.getElementById('serverUrlInput');
            if (input) {
                navigator.clipboard.writeText(input.value).then(function() {
                    var fb = document.getElementById('copyFeedback');
                    if (fb) {
                        fb.classList.remove('d-none');
                        setTimeout(function() { fb.classList.add('d-none'); }, 3000);
                    }
                });
            }
        });
    </script>
}
