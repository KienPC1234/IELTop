@page
@model IELTop_Content_Server.Pages.Papers.IndexModel
@{
    ViewData["Title"] = "Papers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Papers</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-page="/Papers/Import">Import from files</a>
        <a class="btn btn-primary" asp-page="/Papers/Edit">New paper</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input class="form-control" type="search" name="q" value="@Model.Query"
               placeholder="Search by title or id" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <a class="btn btn-link" asp-page="/Papers/Index">Clear</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Category</th>
            <th>Level</th>
            <th>Skills</th>
            <th class="text-end">Parts</th>
            <th class="text-end">Qs</th>
            <th class="text-end">Size</th>
            <th class="text-end">Downloads</th>
            <th>State</th>
            <th>Updated</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Papers)
        {
            <tr class="@(row.IsPublished ? null : "table-warning")">
                <td><code>@row.Id</code></td>
                <td>@row.Title</td>
                <td>@row.Category</td>
                <td>@row.Level</td>
                <td>
                    @foreach (var skill in Model.SkillsOf(row))
                    {
                        <span class="badge text-bg-light border me-1">@skill</span>
                    }
                </td>
                <td class="text-end">@row.PartCount</td>
                <td class="text-end">@row.QuestionCount</td>
                <td class="text-end">@Model.Size(row.SizeBytes)</td>
                <td class="text-end">@row.DownloadCount</td>
                <td>
                    @if (row.IsPublished)
                    {
                        <span class="badge text-bg-success">Published</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Draft</span>
                    }
                </td>
                <td class="text-nowrap">@row.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Papers/Edit"
                       asp-route-id="@row.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-page-handler="Download" asp-route-id="@row.Id">JSON</a>
                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                        <input type="hidden" name="id" value="@row.Id" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                            @(row.IsPublished ? "Unpublish" : "Publish")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Delete" class="d-inline"
                          onsubmit="return confirm('Delete paper @row.Id?');">
                        <input type="hidden" name="id" value="@row.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Papers.Count == 0)
        {
            <tr><td colspan="12" class="text-muted">No papers yet. Import some or create one.</td></tr>
        }
        </tbody>
    </table>
</div>
