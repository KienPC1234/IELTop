@page
@model IELTop_Content_Server.Pages.HealthModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Health - IELTop Content Server</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-body-tertiary">
<div class="container py-4">
    <div class="card">
        <div class="card-body">
            <h1 class="h4">@(Model.Healthy ? "Server is ready" : "Server has a problem")</h1>
            <p class="mb-2">@Model.Message</p>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Protocol</span><code>@Model.Protocol</code>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Address</span><code>@Model.BaseUrl</code>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Papers ready</span><span>@Model.PaperCount</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Audio ready</span><span>@Model.AudioCount</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Auth modes</span><span>@string.Join(", ", Model.AuthModes)</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Database</span><span>@Model.DatabaseProvider</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Cache</span><span>@Model.CacheProvider</span>
                </li>
            </ul>
            <a class="btn btn-primary" asp-page="/Index">Back to the dashboard</a>
        </div>
    </div>
    <p class="text-muted small mt-3 mb-0">
        Add <code>/api/info</code> to the address above to see the greeting the app reads.
    </p>
</div>
</body>
</html>
