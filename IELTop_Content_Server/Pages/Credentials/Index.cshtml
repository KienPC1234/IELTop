@page
@model IELTop_Content_Server.Pages.Credentials.IndexModel
@{
    ViewData["Title"] = "Client access";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Client access</h1>
    <a class="btn btn-outline-secondary" asp-page="/Settings/Index">Auth settings</a>
</div>

@if (Model.MasterCodeSet)
{
    <div class="alert alert-info" role="alert">
        A master code is configured in appsettings. It works without a row below
        and is not shown here on purpose.
    </div>
}

<h2 class="h5 mt-4">Access codes</h2>
<p class="text-muted small">
    A code is handed to a whole class. The app sends it in the X-Access-Code header.
    Codes are stored as typed so you can copy them again.
</p>

<div class="card mb-3">
    <div class="card-body">
        <form method="post" asp-page-handler="CreateCode" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="codeName">Name</label>
                <input class="form-control" id="codeName" name="name" placeholder="Class 12A term 2" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="codeValue">Code (blank to generate)</label>
                <input class="form-control font-monospace" id="codeValue" name="code" placeholder="auto" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="codeExpiry">Expires (optional)</label>
                <input class="form-control" id="codeExpiry" name="expires" type="date" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Create</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>State</th>
            <th>Expires</th>
            <th class="text-end">Uses</th>
            <th>Last used</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var code in Model.Codes)
        {
            <tr class="@(code.IsActive ? null : "table-secondary")">
                <td>@code.Name</td>
                <td><code>@code.Code</code></td>
                <td>
                    @if (code.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Disabled</span>
                    }
                </td>
                <td>@(code.ExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "never")</td>
                <td class="text-end">@code.UseCount</td>
                <td>@(code.LastUsedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                <td class="text-end text-nowrap">
                    <form method="post" asp-page-handler="ToggleCode" class="d-inline">
                        <input type="hidden" name="id" value="@code.Id" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                            @(code.IsActive ? "Disable" : "Enable")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="DeleteCode" class="d-inline"
                          onsubmit="return confirm('Delete code @code.Name?');">
                        <input type="hidden" name="id" value="@code.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Codes.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">No access codes yet.</td></tr>
        }
        </tbody>
    </table>
</div>

<h2 class="h5 mt-5">Login accounts</h2>
<p class="text-muted small">
    A username and password used by POST /api/login. The app then sends the token it
    gets back in the Authorization header. Passwords are stored hashed.
</p>

<div class="card mb-3">
    <div class="card-body">
        <form method="post" asp-page-handler="CreateAccount" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="accUser">Username</label>
                <input class="form-control" id="accUser" name="username" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="accName">Display name</label>
                <input class="form-control" id="accName" name="displayName" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="accPass">Password</label>
                <input class="form-control" id="accPass" name="password" type="text" required minlength="8" />
                <div class="form-text">At least 8 characters. Shown so you can copy it now.</div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Create</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Username</th>
            <th>Display name</th>
            <th>State</th>
            <th>Created</th>
            <th>Last login</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var account in Model.Accounts)
        {
            <tr class="@(account.IsActive ? null : "table-secondary")">
                <td><code>@account.Username</code></td>
                <td>@account.DisplayName</td>
                <td>
                    @if (account.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Disabled</span>
                    }
                </td>
                <td>@account.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td>@(account.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                <td class="text-end text-nowrap">
                    <form method="post" asp-page-handler="ResetPassword" class="d-inline">
                        <input type="hidden" name="id" value="@account.Id" />
                        <input name="password" placeholder="new password" required minlength="8"
                               class="form-control form-control-sm d-inline-block" style="width:11rem" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Reset</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleAccount" class="d-inline">
                        <input type="hidden" name="id" value="@account.Id" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                            @(account.IsActive ? "Disable" : "Enable")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="DeleteAccount" class="d-inline"
                          onsubmit="return confirm('Delete account @account.Username?');">
                        <input type="hidden" name="id" value="@account.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Accounts.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No login accounts yet.</td></tr>
        }
        </tbody>
    </table>
</div>
